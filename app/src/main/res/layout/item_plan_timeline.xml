<?xml version="1.0" encoding="utf-8"?>
<!--
    时间轴条目（v6「轴 + 条目卡」，原型 .tl / .tl-item）：
    左 = 1.5dp outline_variant 竖轴 + 钉在轴上的 primary 圆点（3dp bg 描边圈）；
    右 = surface 条目卡（bg_card + elev_1 + radius_md），卡内为
    标题 / 时间 / 明细 / meta / 「记一笔」动作区（顶部 1dp outline_variant 分隔）。
    ⚠️ tlRail 是线 + 点的容器，为「无时间(旧数据)时整列隐藏」提供整块可见性锚点。
    ⚠️ tlLogAct 是「分隔线 + 记一笔」整块，由代码切换可见性（按钮隐藏时不留残线）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/screen_margin"
    android:layout_marginEnd="@dimen/screen_margin"
    android:orientation="horizontal">

    <!-- 左：竖轴 + 圆点 -->
    <FrameLayout
        android:id="@+id/tlRail"
        android:layout_width="24dp"
        android:layout_height="match_parent">

        <View
            android:id="@+id/tlLine"
            android:layout_width="1.5dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:layout_marginStart="6dp"
            android:background="@color/outline_variant" />

        <View
            android:id="@+id/tlDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="start|top"
            android:layout_marginTop="17dp"
            android:background="@drawable/bg_plan_dot_ring" />
    </FrameLayout>

    <!-- 右：条目卡 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:elevation="@dimen/card_elev_1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tlTitle"
                style="@style/Text.BodyEmphasis"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="力量训练" />

            <TextView
                android:id="@+id/tlTime"
                style="@style/Text.Secondary"
                android:layout_marginStart="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="18:30" />
        </LinearLayout>

        <TextView
            android:id="@+id/tlDetail"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            tools:text="深蹲 4×8 / 卧推 4×8" />

        <TextView
            android:id="@+id/tlMeta"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            tools:text="约 30 分钟 · 午餐后 6 小时，状态正好" />

        <!-- 动作区：顶部 1dp 分隔 + 右对齐「记一笔」；整块由代码切换可见性 -->
        <LinearLayout
            android:id="@+id/tlLogAct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider"
                android:layout_marginTop="8dp"
                android:background="@color/outline_variant" />

            <TextView
                android:id="@+id/btnLogThis"
                style="@style/Text.Link"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:minWidth="@dimen/touch_min"
                android:text="@string/log_this" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
