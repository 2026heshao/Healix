<?xml version="1.0" encoding="utf-8"?>
<!--
    主界面宿主（唯一 Activity）。设计规范系统 4.1 + 11.1 v6；v8 导航骨架 §A.1。

    硬约束：无卡片、无阴影。

    v8 结构（单 Activity + 全 Fragment）：
    - `tabContainer`：**三个常驻 Tab Fragment**（记录 / 助理 / 我的），
      `add` 一次 + `show/hide` 切换 —— Tab 互切零窗口转场、零 Activity 重建。
      此前「记录 / 我的」是 View 容器、「助理」是 Fragment（半迁移），现已统一。
    - `tabbar`：全局底部导航，绝对定位盖底，不占 flex 流；
      排在 tabContainer 之后（z 序更高），输入条抬升由各 Fragment 自带的
      `inputBar`（`marginBottom=@dimen/tab_raise`）承担。
    - `pageContainer`：**九个二级页**（状态详情/设置/计划/个人信息/知识库/资源/
      预设/调试/就医材料）的 Fragment 容器，排在 tabbar 之后 = z 序最高 → 二级页天然
      盖住底部导航，无需显式隐藏。
      ⚠️ 容器**无可见二级页时不进命中测试**：`isClickable` 由宿主按 `NavHost.isOpen`
      （是否有**可见**页）维护 —— keep-alive 下退出的页仍留在容器里但已不可见，
      否则一个透明的 match_parent 容器会把 Tab 页的点击全吞掉。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!--
        Tab 页容器：常驻 3 个 Tab Fragment 挂这里。
        三个 Fragment 的根布局分别是 fragment_record / fragment_assistant /
        fragment_mine，全 match_parent；显隐由宿主 show/hide 控制。
    -->
    <FrameLayout
        android:id="@+id/tabContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        全局底部导航 3 Tab（v6 · 11.1）：64dp，绝对定位盖底，不占 flex 流。
        只在 Tab 页（记录/助理/我的）可见；进二级页时被 pageContainer 覆盖。
    -->
    <include
        android:id="@+id/tabbar"
        layout="@layout/view_tabbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tabbar_height"
        android:layout_gravity="bottom" />

    <!-- ── 二级页容器（v8 T03）：在 tabbar 之后 = z 序最高，天然盖住底部导航 ── -->
    <FrameLayout
        android:id="@+id/pageContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
