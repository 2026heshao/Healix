<?xml version="1.0" encoding="utf-8"?>
<!--
    主界面（设计规范系统 4.1）。
    硬约束：无卡片、无阴影、汇总区不给色块、底部导航只有两个文字入口。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- 顶部：日期 + 设置。无 AppBar 阴影 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin">

        <TextView
            android:id="@+id/dateLabel"
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            tools:text="10月3日 周五" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/line" />

    <!-- 预设横条：横向滚动，13sp text_2，无边框（功能补充 2.1） -->
    <HorizontalScrollView
        android:id="@+id/presetScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/presetRow"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin" />
    </HorizontalScrollView>

    <View
        android:id="@+id/presetDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/line"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- 汇总区：无卡片，大数字本身是视觉中心 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/summary_label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/gapValue"
                style="@style/Text.Numeral"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="+320" />

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/kcal_unit"
                android:layout_gravity="bottom"
                android:paddingBottom="6dp" />
        </LinearLayout>

        <!-- 进度线：高 2dp，圆角 1dp -->
        <ProgressBar
            android:id="@+id/progressLine"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/progress_height"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_line" />

        <TextView
            android:id="@+id/summaryLine"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            tools:text="摄入 2180 · 消耗 1860 · 目标 2500" />
    </LinearLayout>

    <!-- 监督提示条：仅今日无记录时出现，无底色无线 -->
    <TextView
        android:id="@+id/nudgeBar"
        style="@style/Text.Link"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:text="@string/supervise_no_record"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- 计划提示条：整行可点 -->
    <TextView
        android:id="@+id/planBar"
        style="@style/Text.Link"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        tools:text="还差 1280 kcal　查看今日建议 →" />

    <!--
        状态提示条：同一位置承载两种语义（文案与点击行为由 MainActivity 按状态切换）
          - 无网络（state_offline）：点了重试
          - 未配置（no_provider_config）：点了去设置页
        用 text_2 中性色 —— 这两种都是预期行为，不是错误，不该用 negative。
    -->
    <TextView
        android:id="@+id/offlineBar"
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="@string/state_offline"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- 列表：无卡片，1dp 线分隔 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:scrollbars="none" />

        <!-- 空状态：居中 13sp 灰字 + 一行示例 -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_hint" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/empty_example" />
        </LinearLayout>
    </FrameLayout>

    <!-- 底部导航：仅两个文字入口，不用图标导航栏（4.1） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabHome"
            style="@style/Text.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/tab_home"
            android:textColor="@color/text_1" />

        <TextView
            android:id="@+id/tabAssistant"
            style="@style/Text.Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/assistant"
            android:textColor="@color/text_2" />
    </LinearLayout>

    <!-- 速记输入区：高 64dp，顶部 1dp 上边界线，无圆角无卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_height"
        android:background="@drawable/bg_input_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="12dp">

        <EditText
            android:id="@+id/input"
            style="@style/Widget.Healix.QuickInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="@string/hint_quick_input"
            android:importantForAutofill="no"
            android:minHeight="@dimen/input_height" />

        <!-- 状态：细环 + 13sp 灰字（限流必须显示预估秒数） -->
        <ProgressBar
            android:id="@+id/spinner"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/stateLabel"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:visibility="gone"
            tools:text="排队中 · 约 4s"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/send"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_send" />
    </LinearLayout>

</LinearLayout>
