<?xml version="1.0" encoding="utf-8"?>
<!-- 计划建议条目：无卡片，1dp 线分隔，右侧「记一笔」文字按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/itemTitle"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="晚餐 · 约 650 kcal" />

        <TextView
            android:id="@+id/itemDetail"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            tools:text="牛肉 150g + 米饭 200g + 鸡蛋 1 个" />

        <TextView
            android:id="@+id/btnLogThis"
            style="@style/Text.Link"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:layout_gravity="end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:minWidth="@dimen/touch_min"
            android:text="@string/log_this" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:layout_marginStart="@dimen/screen_margin"
        android:background="@color/line" />

</LinearLayout>
