<?xml version="1.0" encoding="utf-8"?>
<!--
    「我的」页（设计规范 11.1，v6 · 3 Tab）：管理类功能的归宿。
    结构 = 概览（状态详情）/ 数据（知识库 · 导出备份）/ 应用（设置 · 调试 · 通知栏录入）。
    卡片圆角 8dp（规范原文 16dp 与 §2.3 全局唯一圆角冲突，以 §2.3 为准）。
    知识库唯一入口从设置页迁至此页（11.1 取代 10.1）。
    底部预留 80dp 给全局 tabbar（11.6 密度预算）。

    v8：由 `view_mine_page.xml` 抽出为常驻 Tab Fragment（[MineFragment]）的根布局。
    根 id 改 `mineRoot`；**去掉 `android:visibility="gone"`** —— 显隐由 FragmentManager
    的 show/hide 控制，根布局自带 gone 会与 hide() 互相打架。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mineRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="@dimen/list_bottom_pad"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 顶部标题：与主界面 56dp 顶栏同规格 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin">

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="@string/mine_title" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"
            android:background="@color/line" />

        <!-- ── 概览 ── -->
        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/mine_group_overview" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <include
                android:id="@+id/rowStatusDetail"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- ── 数据 ── -->
        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/mine_group_data" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <include
                android:id="@+id/rowResources"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider"
                android:layout_marginStart="@dimen/screen_margin"
                android:background="@color/line" />

            <include
                android:id="@+id/rowPresets"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider"
                android:layout_marginStart="@dimen/screen_margin"
                android:background="@color/line" />

            <include
                android:id="@+id/rowKnowledge"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider"
                android:layout_marginStart="@dimen/screen_margin"
                android:background="@color/line" />

            <include
                android:id="@+id/rowPersonalInfo"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider"
                android:layout_marginStart="@dimen/screen_margin"
                android:background="@color/line" />

            <include
                android:id="@+id/rowExport"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- ── 应用 ── -->
        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/mine_group_app" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <include
                android:id="@+id/rowSettings"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider"
                android:layout_marginStart="@dimen/screen_margin"
                android:background="@color/line" />

            <include
                android:id="@+id/rowDebug"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider"
                android:layout_marginStart="@dimen/screen_margin"
                android:background="@color/line" />

            <include
                android:id="@+id/rowNotify"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
