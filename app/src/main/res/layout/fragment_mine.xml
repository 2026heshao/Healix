<?xml version="1.0" encoding="utf-8"?>
<!--
    「我的」页（设计规范 11.1，v6 · 3 Tab）：管理类功能的归宿。

    v6 UI 系统化升级（卡片体系回归）：
      · 顶部个人卡 = 头像 + 姓名 + 副行（体重 · 目标）；
      · 目标四宫格 = 体重 / 运动 / 睡眠 / 饮水（各带 6dp 迷你进度条）；
      · 原「去卡片化」的三组通栏行 → 每组一张 bg_card 包裹，组标题用
        Widget.Healix.SectionTitle，行高仍 setting_row_height(56dp)；
      · 行 id 全部保持不变（MineFragment 按 id 绑定点击）。

    底部预留 list_bottom_pad 给全局 tabbar（11.6 密度预算）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mineRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="@dimen/list_bottom_pad"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp">

        <!-- 顶部标题：与主界面 56dp 顶栏同规格 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin">

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="@string/mine_title" />
        </RelativeLayout>

        <!-- ══ 个人卡 ══ 头像 + 姓名 + 副行（体重 · 目标） -->
        <LinearLayout
            style="@style/Widget.Healix.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/profileAvatar"
                android:layout_width="@dimen/avatar_size"
                android:layout_height="@dimen/avatar_size"
                android:background="@drawable/bg_avatar"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="H"
                android:textColor="@color/on_primary_container"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profileName"
                    style="@style/Text.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/dui_profile_name"
                    tools:text="Healix 用户" />

                <TextView
                    android:id="@+id/profileMeta"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_2"
                    tools:text="体重 71.5 kg · 增重" />
            </LinearLayout>

            <!--
                ⚠️ v6 画板里的「连续达标 7 天徽章」**已移除**（不落地）。
                原因：PRD 硬规则 R5 + 规范 §9.12 禁止「可累积 / 会归零 / 给奖励 / 能排行」
                的 streak 机制，由 `pipeline/check_kotlin.py` 的 check_no_gamification
                静态守卫；且全仓不存在「连续达标」聚合口径 —— 落一个无数据源的
                `visibility=gone` 视图等于死代码。若将来要做同类正反馈，改用
                「描述性」口径（如「本周达标 5/7 天」，R5 明确允许描述数据的文案）。
            -->
        </LinearLayout>

        <!-- ══ 目标四宫格（2×2）：体重 / 运动 / 睡眠 / 饮水 ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="@dimen/screen_margin"
            android:orientation="horizontal">

            <!-- 体重 -->
            <LinearLayout
                android:id="@+id/cardWeight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/card_elev_1"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_weight"
                        android:textColor="@color/text_2" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron"
                        android:tint="@color/text_3" />
                </LinearLayout>

                <TextView
                    android:id="@+id/goalWeightValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/text_1"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="71.5 kg" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_gbar_track">

                    <View
                        android:id="@+id/goalWeightFill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_gbar_go" />
                </FrameLayout>
            </LinearLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <!-- 运动 -->
            <LinearLayout
                android:id="@+id/cardExercise"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/card_elev_1"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dui_goal_exercise"
                        android:textColor="@color/text_2" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron"
                        android:tint="@color/text_3" />
                </LinearLayout>

                <TextView
                    android:id="@+id/goalExerciseValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/text_1"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="2/3 次" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_gbar_track">

                    <View
                        android:id="@+id/goalExerciseFill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_gbar_mid" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="@dimen/screen_margin"
            android:orientation="horizontal">

            <!-- 睡眠 -->
            <LinearLayout
                android:id="@+id/cardSleep"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/card_elev_1"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dui_goal_sleep"
                        android:textColor="@color/text_2" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron"
                        android:tint="@color/text_3" />
                </LinearLayout>

                <TextView
                    android:id="@+id/goalSleepValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/text_1"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="6.4 h" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_gbar_track">

                    <View
                        android:id="@+id/goalSleepFill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_gbar_mid" />
                </FrameLayout>
            </LinearLayout>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <!-- 饮水 -->
            <LinearLayout
                android:id="@+id/cardWater"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:elevation="@dimen/card_elev_1"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dui_goal_water"
                        android:textColor="@color/text_2" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron"
                        android:tint="@color/text_3" />
                </LinearLayout>

                <TextView
                    android:id="@+id/goalWaterValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/text_1"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="1700 ml" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_gbar_track">

                    <View
                        android:id="@+id/goalWaterFill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_gbar_ok" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ══ 概览 ══ -->
        <TextView
            style="@style/Widget.Healix.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mine_group_overview" />

        <LinearLayout
            style="@style/Widget.Healix.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp">

            <include
                android:id="@+id/rowStatusDetail"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- ══ 数据 ══ -->
        <TextView
            style="@style/Widget.Healix.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mine_group_data" />

        <LinearLayout
            style="@style/Widget.Healix.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp">

            <include
                android:id="@+id/rowResources"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowPresets"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowKnowledge"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowPersonalInfo"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowExport"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!--
                导入数据（v8 T07 / 需求 8）：与「导出备份」配成一对 ——
                只有导出没有读回时，导出的 JSON 是死数据，换机 / 重装没有任何还原路径。
            -->
            <include
                android:id="@+id/rowImport"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!--
                备份须知（13sp text_3，无底色）：导出文件是**明文** JSON，含健康记录与
                个人描述；导入不含 API Key。两句都是用户做决定前必须知道的。
            -->
            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="@dimen/screen_margin"
                android:text="@string/backup_note"
                android:textColor="@color/text_3" />

            <!--
                就医准备材料（v8 需求 9 功能 3）：把一段时间窗内的事实整理成一页
                可交给医生的纯文本，与「导出备份」并列在数据组。
            -->
            <include
                android:id="@+id/rowMedical"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- ══ 应用 ══ -->
        <TextView
            style="@style/Widget.Healix.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mine_group_app" />

        <LinearLayout
            style="@style/Widget.Healix.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/block_gap"
            android:orientation="vertical"
            android:padding="0dp">

            <include
                android:id="@+id/rowSettings"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowDebug"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowNotify"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
