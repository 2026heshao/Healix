<?xml version="1.0" encoding="utf-8"?>
<!--
    ActionConfirmSheet（§5.1 统一确认类弹窗）：复用 EventEditSheet 的底色容器规格
    （§3.5：bg_sheet + GrabberLayout + 把手 36×3dp）。
    结构 = 把手 + 标题 + 单行消息 + 底部右对齐「取消 + 确认」。
    用于 proposal 确认 / 预设删除确认（取代系统 AlertDialog）。
-->
<com.healix.app.ui.GrabberLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="20dp">

        <!-- 把手 -->
        <View
            android:layout_width="@dimen/handle_width"
            android:layout_height="@dimen/handle_height"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_handle" />

        <TextView
            android:id="@+id/sheetTitle"
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="确认记录" />

        <TextView
            android:id="@+id/sheetMessage"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_2"
            tools:text="助理拟了一条记录：「晚餐 1 碗面」。现在记下来吗？" />

        <!-- 底部按钮：右对齐 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCancel"
                style="@style/Text.Link"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/cancel" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnConfirm"
                style="@style/Widget.Healix.Button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/confirm" />
        </LinearLayout>

    </LinearLayout>

</com.healix.app.ui.GrabberLayout>
