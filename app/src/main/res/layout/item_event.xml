<?xml version="1.0" encoding="utf-8"?>
<!--
    记录列表项（组件规范 3.3 + 11.3 v6 左滑操作）。
    · 饮食                        12:30
      中午吃了牛肉面加鸡蛋
      约 600 kcal
    ──────────────────────────  1dp 线（左缩进 20dp）

    v6：行外包 swipewrap —— 下层常驻「编辑」（text_3 底）/「删除」（negative 底）
    两枚 72dp 按钮，行左滑露出；拖拽/吸附/回弹逻辑在 SwipeRows.kt。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- swipewrap：滑动层（swipeItem）盖在常驻按钮（swipeActs）上 -->
    <FrameLayout
        android:id="@+id/swipeWrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 下层常驻操作按钮：编辑（text_3 底）/ 删除（negative 底），各 72dp -->
        <LinearLayout
            android:id="@+id/swipeActs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/actEdit"
                android:layout_width="@dimen/swipe_act_width"
                android:layout_height="match_parent"
                android:background="@color/text_3"
                android:gravity="center"
                android:text="@string/edit"
                android:textColor="@color/btn_primary_text" />

            <TextView
                android:id="@+id/actDelete"
                android:layout_width="@dimen/swipe_act_width"
                android:layout_height="match_parent"
                android:background="@color/negative"
                android:gravity="center"
                android:text="@string/delete"
                android:textColor="@color/btn_primary_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/swipeItem"
            style="@style/Widget.Healix.ListRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:orientation="horizontal">

        <!-- 6px 低饱和圆点，垂直居中于第一行 -->
        <View
            android:id="@+id/dot"
            android:layout_width="@dimen/dot_size"
            android:layout_height="@dimen/dot_size"
            android:layout_gravity="top"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/dot" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/typeLabel"
                    style="@style/Text.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="饮食" />

                <TextView
                    android:id="@+id/timeLabel"
                    style="@style/Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="12:30" />
            </LinearLayout>

            <TextView
                android:id="@+id/bodyText"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="中午吃了牛肉面加鸡蛋" />

            <TextView
                android:id="@+id/summaryText"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:visibility="gone"
                tools:text="约 600 kcal"
                tools:visibility="visible" />

            <!-- 失败提示：出现在该行下方，不弹窗 -->
            <TextView
                android:id="@+id/errorText"
                style="@style/Text.Danger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="识别失败 · 重试"
                tools:visibility="visible" />

            <!-- 待处理标记：pending 状态 -->
            <TextView
                android:id="@+id/pendingText"
                style="@style/Text.Tertiary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/state_parsing"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
    </FrameLayout>

    <!-- 分隔线：左缩进 20dp -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:layout_marginStart="@dimen/screen_margin"
        android:background="@color/line" />

</LinearLayout>
