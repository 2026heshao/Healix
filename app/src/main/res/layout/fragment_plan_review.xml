<?xml version="1.0" encoding="utf-8"?>
<!--
    计划 / 回顾（设计规范系统 4.3 / 增量设计 §E）。
    v8 需求 7：原「计划 | 训练 | 回顾」三 Tab 收敛为「计划 | 回顾」——
    训练日与今日计划条目合并到**同一条按周铺开的时间轴**（见 TimelineMerger），
    页面不再有手动「更新」「刷新」主按钮（AI 重排改为后台自动，≤1 次/日）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingEnd="@dimen/screen_margin">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back" />

        <!-- 顶部文字 Tab，选中态 text_1 + 下方 2dp accent 线 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tabPlan"
                    style="@style/Text.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:minWidth="64dp"
                    android:text="@string/tab_plan" />

                <View
                    android:id="@+id/tabPlanUnderline"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/accent" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tabReview"
                    style="@style/Text.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:minWidth="64dp"
                    android:text="@string/tab_review" />

                <View
                    android:id="@+id/tabReviewUnderline"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/accent"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/line" />

    <!--
        缺口行：还差 X kcal（body15/text_1）。
        ⚠️ **不用 accent**：这一行是**被动状态**，不可点、不带动作 —— 唯一强调色只留给
        可点动作与需要用户注意的强调（`Text.Body` 已是 text_1，此处不再覆写颜色）。
        与原型的 `color: var(text_1)` 口径一致（UI-v8优化原型.html:398）。
    -->
    <TextView
        android:id="@+id/gapLabel"
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        tools:text="还差 1280 kcal" />

    <View
        android:id="@+id/gapDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/line" />

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 计划 Tab 内容：一条按周铺开的统一时间轴（训练日 + 今日计划） -->
            <LinearLayout
                android:id="@+id/planGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 来源行：来源名 · HH:mm 生成（无计划条目时不显示） -->
                <TextView
                    android:id="@+id/planSourceLabel"
                    style="@style/Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp"
                    tools:text="AI 计划 · 09:30 生成" />

                <!-- 提示行：自动重排中 / 失败 / 配额不足 / 兜底模式 -->
                <TextView
                    android:id="@+id/planModeLabel"
                    style="@style/Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin"
                    android:paddingBottom="8dp"
                    android:text="@string/mode_simplified_local"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- 内联撤销条（规范 §9.6）：全宽 48dp，无底色无边框，同时最多 1 条 -->
                <LinearLayout
                    android:id="@+id/undoBar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/undoLeft"
                        style="@style/Text.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="已记录 运动 · 推（胸/肩/三头）" />

                    <TextView
                        android:id="@+id/undoAction"
                        style="@style/Text.Link"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_min"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center"
                        android:minWidth="@dimen/touch_min"
                        android:text="@string/undo" />
                </LinearLayout>

                <!-- 本周训练汇总行：本周 N 练 · 已完成 M（无训练计划时隐藏） -->
                <TextView
                    android:id="@+id/trainingSummary"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin"
                    android:paddingTop="20dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone"
                    tools:text="本周 3 练 · 已完成 2"
                    tools:visibility="visible" />

                <!-- 本周训练重点（TrainingPlan.note）：原「训练」Tab 页脚迁移至此 -->
                <TextView
                    android:id="@+id/trainingFocus"
                    style="@style/Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin"
                    android:paddingBottom="8dp"
                    android:visibility="gone"
                    tools:text="本周重点：卧推尝试比上周加 2.5kg"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/itemContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!--
                    空态入口（问题 3 方案 C）：时间轴一条都没有时的「生成今日计划」。
                    只在 `entries` 为空时可见（见 PlanReviewFragment.renderTimeline）。
                    有计划时的手动入口 = 下方 `btnRerankToday`（用户 2026-10-06 要求
                    恢复常驻手动重排；用户主动点击才调 AI，打开页面仍是 0 AI）。
                -->
                <LinearLayout
                    android:id="@+id/planEmptyRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin"
                    android:paddingTop="@dimen/block_gap"
                    android:paddingBottom="@dimen/block_gap"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/Text.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/plan_empty_today" />

                    <TextView
                        android:id="@+id/btnGenerateToday"
                        style="@style/Text.Link"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="start|center_vertical"
                        android:minHeight="@dimen/touch_min"
                        android:text="@string/plan_generate_today" />
                </LinearLayout>

                <TextView
                    android:id="@+id/planNote"
                    style="@style/Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin"
                    android:paddingTop="@dimen/block_gap"
                    android:paddingBottom="@dimen/block_gap"
                    tools:text="今日蛋白质偏低，晚餐优先补蛋白" />

                <!--
                    手动重排入口（常驻、低调文字行）：仅 `entries` 非空时可见
                    （空态走上方 planEmptyRow，两者互斥不重复）。
                    点击 = 用户主动调一次模型 —— generateTodayPlan 自带配额门禁，
                    且先落日标记（当日自动重排让位）。生成中禁用并显示「生成中…」。
                -->
                <TextView
                    android:id="@+id/btnRerankToday"
                    style="@style/Text.Link"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="start|center_vertical"
                    android:minHeight="@dimen/touch_min"
                    android:text="@string/plan_rerank_today"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- 无训练计划时的**低调文字入口**（非主按钮）：
                     需求 7 去掉手动「更新」后，整周计划仍需一个生成入口。 -->
                <LinearLayout
                    android:id="@+id/trainingGenerateRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin"
                    android:paddingTop="@dimen/block_gap"
                    android:paddingBottom="@dimen/block_gap"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/trainingIntro"
                        style="@style/Text.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="结合你的目标（增重）和本周已练肌群，一次生成 7 天安排。" />

                    <TextView
                        android:id="@+id/trainingFailed"
                        style="@style/Text.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/training_failed"
                        android:textColor="@color/negative"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/btnGenerateWeek"
                        style="@style/Text.Link"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="start|center_vertical"
                        android:minHeight="@dimen/touch_min"
                        android:text="@string/training_generate" />

                    <TextView
                        android:id="@+id/trainingGoalFooter"
                        style="@style/Text.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        tools:text="本周目标 3 次 · 休息日也会排出来" />
                </LinearLayout>
            </LinearLayout>

            <!-- 复盘 Tab 内容：三宫格用文字对齐 -->
            <LinearLayout
                android:id="@+id/reviewGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:baselineAligned="true"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statIn"
                            style="@style/Text.Numeral"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="28sp"
                            tools:text="2180" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/review_stat_kcal_in" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statOut"
                            style="@style/Text.Numeral"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="28sp"
                            tools:text="1860" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/review_stat_kcal_out" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statWeight"
                            style="@style/Text.Numeral"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="28sp"
                            tools:text="58.2" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/review_stat_weight" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/reviewText"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin"
                    android:paddingTop="24dp"
                    tools:text="今天热量盈余 320 kcal，达到增重目标。" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 免责声明常驻底部 -->
    <TextView
        style="@style/Text.Tertiary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:text="@string/disclaimer"
        android:textSize="12sp" />

</LinearLayout>
