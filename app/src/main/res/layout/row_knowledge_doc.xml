<?xml version="1.0" encoding="utf-8"?>
<!--
    知识库文档行（设计规范系统 10.2）：64dp 双行（minHeight，文字放大允许增高）。
    第一行标题 15sp text_1 一行截断；第二行 13sp 承载四态，全部中性色。
    1dp 分隔线左缩进 20dp（3.4 惯例）。行内无图标、无圆点。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/docRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:minHeight="64dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="63dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/docTitle"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="训练计划.pdf" />

        <!-- 四态文案：解析中 text_3 / 元信息 text_2 / 失败与扫描版 text_2 可点 -->
        <TextView
            android:id="@+id/docSubtitle"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="?attr/selectableItemBackground"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="12 页 · 2.1 MB" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:layout_marginStart="@dimen/screen_margin"
        android:background="@color/line" />

</LinearLayout>
