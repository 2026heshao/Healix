<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页（设计规范 4.4 / v6 卡片体系）：分组卡片包裹，组标题 Widget.Healix.SectionTitle，
     行高 56dp 不变（v6 卡片行内无分隔线）。
     v8 需求 4/6：
       · 目标组由**固定 include** 改为**动态容器 goalContainer**（左滑删除 + 添加目标）；
       · 删除「隐私」组（HIDE_KCAL/HIDE_WEIGHT 键与消费方保留，仅去掉 UI 入口）；
       · 新增内联撤销条 undoBar（与首页同构，左滑删除后 5 秒可撤销）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingEnd="@dimen/screen_margin">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_toEndOf="@id/btnBack"
            android:gravity="center_vertical"
            android:text="@string/settings" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/line" />

    <!--
        内联撤销条（规范 §9.6）：左滑删除目标 / 提醒后出现，5 秒后自动消失。
        与首页同构 —— 无底色无边框，靠文字区分。放在工具栏正下方（不进 ScrollView），
        保证无论列表滚到哪里都可见。
    -->
    <LinearLayout
        android:id="@+id/undoBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/undoLeft"
            style="@style/Text.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="已删除「睡眠目标」" />

        <TextView
            android:id="@+id/undoAction"
            style="@style/Text.Link"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:minWidth="@dimen/touch_min"
            android:text="@string/undo" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="32dp">

            <!-- ══ 模型服务 ══ -->
            <TextView
                style="@style/Widget.Healix.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/group_model" />

            <LinearLayout
                style="@style/Widget.Healix.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="0dp">

                <include
                    android:id="@+id/rowProvider"
                    layout="@layout/row_setting_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowBaseUrl"
                    layout="@layout/row_setting_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowModel"
                    layout="@layout/row_setting_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowApiKey"
                    layout="@layout/row_setting_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!--
                接入 / 启用：本节第一主按钮。
                「填了 → 接入 → 才生效」是用户的心智模型，必须有一个显式的落地点。
                行为 = 写配置 + 校验完整性 + 发一次真实请求验证（见 runApply）。
            -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnApply"
                style="@style/Widget.Healix.Button"
                android:layout_width="match_parent"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="@dimen/screen_margin"
                android:text="@string/apply_provider" />

            <!-- 接入状态：常驻显示当前是「已接入」还是「未接入」，不靠弹窗 -->
            <TextView
                android:id="@+id/applyStatus"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="@dimen/screen_margin"
                tools:text="已接入 · 智谱 GLM · glm-4-flash"
                tools:visibility="visible" />

            <!--
                测试连通性：本节次级主动作，用 Tonal 按钮（secondary_container 底、secondary 文字），
                与主按钮（primary 底）层级分明。
            -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnTest"
                style="@style/Widget.Healix.ButtonTonal"
                android:layout_width="match_parent"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="@dimen/screen_margin"
                android:text="@string/test_conn" />

            <!-- 测试结果就地显示，不弹 Toast（结果需要能被反复查看） -->
            <TextView
                android:id="@+id/testResult"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="@dimen/screen_margin"
                android:visibility="gone"
                tools:text="连通 · 1.2s"
                tools:visibility="visible" />

            <!-- ══ 调用限制 ══ -->
            <TextView
                style="@style/Widget.Healix.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/group_quota" />

            <LinearLayout
                style="@style/Widget.Healix.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="0dp">

                <!-- 日界线（原「个人」组上移至此）：决定配额日窗口与会话切日，是系统参数 -->
                <include
                    android:id="@+id/rowDayStart"
                    layout="@layout/row_setting_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowExtractQuota"
                    layout="@layout/row_setting_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowChatQuota"
                    layout="@layout/row_setting_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowRetry"
                    layout="@layout/row_setting_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowRetryDelay"
                    layout="@layout/row_setting_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ══ 目标 ★v4（规范 9.7 ①）══
                 读写落在 goals 表（不是 settings 表）。行由 goalDao().observeActive() 动态渲染
                 （左滑删除），主目标行不出删除位（is_primary==1）；末尾「添加目标」恢复归档项。 -->
            <TextView
                android:id="@+id/goalSectionHeader"
                style="@style/Widget.Healix.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/group_goal" />

            <!--
                v8 问题 2a：老用户把热量目标从「个人信息页」搬进本栏后，
                仅一次提示「热量目标现已移至此栏」（13sp text_2）。可点关闭。
            -->
            <TextView
                android:id="@+id/goalKcalMovedHint"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="8dp"
                android:visibility="gone"
                tools:text="热量目标现已移至此栏"
                tools:visibility="visible" />

            <!--
                目标组「依据提示」（规范 9.7）：13sp text_3，仅首次打开该组时显示一次。
                形式裁决 = 放组标题下方一行（体重/训练/睡眠/饮水默认值同出一个来源）。
            -->
            <TextView
                android:id="@+id/goalSourceHint"
                style="@style/Text.Tertiary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="8dp"
                android:visibility="gone"
                tools:text="来自膳食指南推荐量"
                tools:visibility="visible" />

            <LinearLayout
                style="@style/Widget.Healix.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="0dp">

                <!-- 动态目标行容器：每行 inflate item_swipe_row.xml 后加入 -->
                <LinearLayout
                    android:id="@+id/goalContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!--
                    v8 问题 2b：删掉默认种子后的空态说明 —— 仅主目标、无任何次目标时显示
                    `还没有次目标`（12sp text_3）。可见性由 SettingsFragment.renderGoals 控制。
                -->
                <TextView
                    android:id="@+id/goalEmptyHint"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin"
                    android:paddingBottom="4dp"
                    android:text="@string/goal_empty_no_secondary"
                    android:textColor="@color/text_3"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!--
                    「添加目标」入口（常驻栏底，唯一显式创建入口）。
                    槽位加满时原地降级为禁用态，状态由 SettingsFragment.updateGoalAddEntry 控制。
                -->
                <include
                    android:id="@+id/rowGoalAdd"
                    layout="@layout/row_setting_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ══ 热量摄入 ★清单3 R3（规范 9.7 ①，与其它组标题同构）══
                 kcal 的唯一 UI 入口：开关行（HIDE_KCAL 取反，键复用零新增）+ 数值行。 -->
            <TextView
                style="@style/Widget.Healix.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/group_kcal_intake" />

            <LinearLayout
                style="@style/Widget.Healix.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="0dp">

                <include
                    android:id="@+id/rowKcalSwitch"
                    layout="@layout/row_setting_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowKcalGoal"
                    layout="@layout/row_setting_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!--
                ══ AI 可见资料范围 + AI 工具与写权限 ★ViewStub 懒建（2026-10-08）══
                这一组是设置页最重的一块（9 个 include / ~37 view，含 SwitchMaterial）
                且整组在**首屏之外** —— 原实现写在同一个布局里，等于每次首开都为一块
                当场看不到的内容付全额 inflate，正是二级页转场起手掉帧的大头
                （见 `docs/v8/专项-二级页转场卡顿-2026-10-05.md` §4.0 续2）。
                内容见 `layout/group_settings_ai.xml`（原样搬运，零改动）。
                inflate 时机 = 转场结束后 / 用户开始下滑（SettingsFragment.ensureAiGroup）。
            -->
            <ViewStub
                android:id="@+id/aiGroupStub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout="@layout/group_settings_ai" />

            <!-- ══ 提醒 ★v4（规范 9.7 ③）══
                 读写落在 reminders 表。行是动态渲染的（可增删 + 左滑删除）。 -->
            <TextView
                style="@style/Widget.Healix.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/group_reminder" />

            <LinearLayout
                style="@style/Widget.Healix.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="0dp">

                <LinearLayout
                    android:id="@+id/reminderContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <include
                    android:id="@+id/rowReminderAdd"
                    layout="@layout/row_setting_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- v6（11.1）：「数据 / 调试 / 知识库」三组迁「我的」页，设置页回归纯配置。
                 v8 需求 6：原「隐私」组（HIDE_KCAL / HIDE_WEIGHT）UI 入口整体移除；
                 两个 settings 键与全部消费方保留。 -->
        </LinearLayout>
    </ScrollView>
</LinearLayout>
