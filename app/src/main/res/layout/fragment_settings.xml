<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页（设计规范系统 4.4）：纯列表 + 分隔线，分组标题 12sp text_2，行高 56dp。
     v8 需求 4/6：
       · 目标组由**固定 include** 改为**动态容器 goalContainer**（左滑删除 + 添加目标）；
       · 删除「隐私」组（HIDE_KCAL/HIDE_WEIGHT 键与消费方保留，仅去掉 UI 入口）；
       · 新增内联撤销条 undoBar（与首页同构，左滑删除后 5 秒可撤销）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingEnd="@dimen/screen_margin">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_toEndOf="@id/btnBack"
            android:gravity="center_vertical"
            android:text="@string/settings" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/line" />

    <!--
        内联撤销条（规范 §9.6）：左滑删除目标 / 提醒后出现，5 秒后自动消失。
        与首页同构 —— **无底色无边框**，靠文字区分。放在工具栏正下方（不进 ScrollView），
        保证无论列表滚到哪里都可见。
    -->
    <LinearLayout
        android:id="@+id/undoBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/undoLeft"
            style="@style/Text.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="已删除「睡眠目标」" />

        <TextView
            android:id="@+id/undoAction"
            style="@style/Text.Link"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:minWidth="@dimen/touch_min"
            android:text="@string/undo" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- 模型服务 -->
            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:text="@string/group_model" />

            <include
                android:id="@+id/rowProvider"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowBaseUrl"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowModel"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowApiKey"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!--
                接入 / 启用：本节第一主按钮。
                「填了 → 接入 → 才生效」是用户的心智模型，必须有一个显式的落地点。
                行为 = 写配置 + 校验完整性 + 发一次真实请求验证（见 runApply）。
            -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnApply"
                style="@style/Widget.Healix.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginEnd="@dimen/screen_margin"
                android:layout_marginTop="16dp"
                android:text="@string/apply_provider" />

            <!-- 接入状态：常驻显示当前是「已接入」还是「未接入」，不靠弹窗 -->
            <TextView
                android:id="@+id/applyStatus"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginEnd="@dimen/screen_margin"
                android:layout_marginTop="8dp"
                tools:text="已接入 · 智谱 GLM · glm-4-flash"
                tools:visibility="visible" />

            <!-- 测试连通性：本节第二按钮，样式降一级为文字按钮（避免两个同权重主按钮） -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnTest"
                style="@style/Widget.Healix.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginEnd="@dimen/screen_margin"
                android:layout_marginTop="4dp"
                android:text="@string/test_conn" />

            <!-- 测试结果就地显示，不弹 Toast（结果需要能被反复查看） -->
            <TextView
                android:id="@+id/testResult"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginEnd="@dimen/screen_margin"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                tools:text="连通 · 1.2s"
                tools:visibility="visible" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider"
                android:layout_marginTop="@dimen/block_gap"
                android:background="@color/line" />

            <!-- 调用限制 -->
            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:text="@string/group_quota" />

            <!-- 日界线（原「个人」组上移至此）：决定配额日窗口与会话切日，是系统参数 -->
            <include
                android:id="@+id/rowDayStart"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowExtractQuota"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowChatQuota"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowRetry"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowRetryDelay"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- ══ 目标 ★v4（规范 9.7 ①）══
                 读写落在 goals 表（不是 settings 表）：目标有"起始值 / 目标值 / 主目标"
                 三个维度，且首页状态行、训练处方都要读它，塞进 settings 会再次分裂语义。
                 v8 需求 4：行由 `goalDao().observeActive()` **动态渲染**（左滑删除），
                 主目标行不出删除位（is_primary==1）；末尾「添加目标」恢复归档项。 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider"
                android:layout_marginTop="@dimen/block_gap"
                android:background="@color/line" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:text="@string/group_goal" />

            <!--
                目标组「依据提示」（规范 9.7）：13sp text_3，仅首次打开该组时显示一次。
                形式裁决 = 放**组标题下方一行**，而非规范字面的「每项值下方」：
                体重/训练/睡眠/饮水的默认值同出一个来源（《中国居民膳食指南(2022)》），
                逐项重复 5 遍只是噪声。可见性由 SettingsFragment.setupGoalSourceHint() 控制。
            -->
            <TextView
                android:id="@+id/goalSourceHint"
                style="@style/Text.Tertiary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="8dp"
                android:visibility="gone"
                tools:text="来自膳食指南推荐量"
                tools:visibility="visible" />

            <!-- 动态目标行容器：每行 inflate item_swipe_row.xml 后加入 -->
            <LinearLayout
                android:id="@+id/goalContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <include
                android:id="@+id/rowGoalAdd"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- ══ 提醒 ★v4（规范 9.7 ③）══
                 读写落在 reminders 表。行是**动态渲染**的（可增删 + 左滑删除），
                 所以容器用 LinearLayout，行由代码 inflate item_swipe_row.xml 后加入。
                 v8 需求 4：**不再预置**默认提醒（体检/洗牙/配镜），仅保留「添加提醒」入口。 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider"
                android:layout_marginTop="@dimen/block_gap"
                android:background="@color/line" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:text="@string/group_reminder" />

            <LinearLayout
                android:id="@+id/reminderContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <include
                android:id="@+id/rowReminderAdd"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- v6（11.1）：「数据 / 调试 / 知识库」三组迁「我的」页（fragment_mine.xml），
                 设置页回归纯配置（模型服务 / 调用限制 / 目标 / 提醒）。
                 v8 需求 6：原「隐私」组（HIDE_KCAL / HIDE_WEIGHT）UI 入口整体移除；
                 两个 settings 键与全部消费方（首页汇总区 / 状态详情页 / 对话系统提示）保留。 -->
        </LinearLayout>
    </ScrollView>

</LinearLayout>
