<?xml version="1.0" encoding="utf-8"?>
<!--
    全局底部导航 3 Tab（设计规范 11.1）：
    记录 ｜ 助理 ｜ 我的，64dp，绝对定位盖底（include 宿主负责 layout_gravity=bottom）。
    tabbar 不属于任何屏：只在 Tab 页可见，进二级页由 TabBar 隐藏。
    顶部 1dp 线复用 bg_input_bar 的描边规格（surface 底 + line 上边线）。
    选中态 text_1 / 未选中 text_2，13sp —— 与原型 .tabbar 一致。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/tabbar_height"
    android:orientation="horizontal"
    android:background="@drawable/bg_input_bar">

    <TextView
        android:id="@+id/tabRecord"
        style="@style/Text.Button"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/tab_home"
        android:textColor="@color/text_1" />

    <TextView
        android:id="@+id/tabAssistant"
        style="@style/Text.Button"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/assistant"
        android:textColor="@color/text_2" />

    <TextView
        android:id="@+id/tabMine"
        style="@style/Text.Button"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/tab_mine"
        android:textColor="@color/text_2" />

</LinearLayout>
