<?xml version="1.0" encoding="utf-8"?>
<!--
    「记录」页滚动 header（v6 记录页改版；原 v0.3 B2 合并滚动区）。
    承载**内容型**信息（随列表滚动离场）：
        presetScroll（Filter chips）+ Hero 卡 + metricsRow（三枚指标 chip）
        + 主目标行 + planBar + nudgeBar。
    操作反馈（offlineBar / undoBar）与输入条（inputBar）留在 fragment_record.xml
    固定区，不得移入本文件（undoBar 的 5s 定时器挂在固定 View 上，绝不能随
    RecyclerView 回收，见 UndoBar 的 WeakHashMap 不变量）。

    v6 变化（对照 docs/prototypes/UI-升级方案高仿真-v6.html 记录页）：
      ① 预设横条由灰字横滚升级为 Filter chips（垂直序提到最前，点选仍为直写零弹窗）；
      ② 原「今日盈余 32dp 单行」升级为 Hero 卡（bg_hero_card 衬底 + Text.Hero 主数字
         + 8dp 进度条 + 右侧 76dp 达标环）；
      ③ 原「三卡横排 + 单行状态」合并为三枚 MetricChip（运动 / 睡眠 / 体重，各带
         20dp SparklineView）；有未读信号时右一（体重位）原地切成 warning 衬底，
         两态互斥、恒定单行 48dp；
      ④ 主目标行 / 计划提示条 / 监督提示条**原样保留**（功能不删）。

    id 与抽离前保持兼容：RecordFragment 经 ItemRecordHeaderBinding 以
    `headerBinding.xxx` 访问。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!--
        Filter chips：预设 + 最近记录共用一条横滚（功能补充 2.1 / 功能 5）。
        点一下 = 一条记录，完全不打字、不调 AI，**零弹窗**。
        由 RecordFragment.renderPresetStrip 动态 inflate item_rec_chip.xml。
    -->
    <HorizontalScrollView
        android:id="@+id/presetScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/presetRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </HorizontalScrollView>

    <!--
        Hero 卡：热量summary 的 v6 形态。
        - 左列：标题（今日盈余）+ Text.Hero(40sp/600) 主数字 + 单位 + 8dp 进度条
          + 摄入 / 消耗 / 目标 副行；
        - 右列：76dp 环形达标率（HeroRingView，primary 弧 + progress_track 轨道）。
        点整卡 → 盈余视角详情弹层（GoalDetailSheet.TAB_GAP，沿用旧「今日盈余」去向）。
        隐私（HIDE_KCAL）打开时整卡隐藏，进度与环一并隐藏。
    -->
    <LinearLayout
        android:id="@+id/heroCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_hero_card"
        android:clickable="true"
        android:elevation="@dimen/card_elev_1"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/heroLabel"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/summary_label"
                android:textColor="@color/on_primary_container" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/heroNum"
                    style="@style/Text.Hero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_primary_container"
                    tools:text="+328" />

                <TextView
                    android:id="@+id/heroUnit"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="4dp"
                    android:paddingBottom="6dp"
                    android:text="@string/kcal_unit"
                    android:textColor="@color/on_primary_container" />
            </LinearLayout>

            <!-- 8dp 进度条：轨道 + 填充由 renderHero 按 摄入 / 目标 比例设权重 -->
            <LinearLayout
                android:id="@+id/heroBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hero_progress_height"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_progress_track"
                android:orientation="horizontal"
                android:weightSum="100">

                <View
                    android:id="@+id/heroBarFill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    android:background="@drawable/bg_progress_fill" />

                <View
                    android:id="@+id/heroBarRest"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="100" />
            </LinearLayout>

            <TextView
                android:id="@+id/heroSub"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/on_primary_container"
                tools:text="摄入 2180 · 消耗 1860 · 目标 2500" />
        </LinearLayout>

        <com.healix.app.ui.widget.HeroRingView
            android:id="@+id/heroRing"
            android:layout_width="@dimen/hero_ring_size"
            android:layout_height="@dimen/hero_ring_size"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <!--
        多维指标行（规范 §9.2 / v6 §四）：三枚 MetricChip（运动 / 睡眠 / 体重），
        各带 20dp SparklineView；恒定单行 48dp，**两态互斥** ——
        无信号：chip 一 / 二 / 三 = 运动 / 睡眠 / 体重；
        有未读信号：右一原地切成 warning_container 衬底 + warning 文字（体重 chip 隐藏），
                   高度与列数不变。信号态点右一进状态详情页（默认身体段）并标记已读。
    -->
    <LinearLayout
        android:id="@+id/metricsRow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/metric_chip_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin">

        <LinearLayout
            android:id="@+id/metricTrain"
            style="@style/Widget.Healix.MetricChip"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <com.healix.app.ui.widget.SparklineView
                android:id="@+id/metricTrainSpark"
                android:layout_width="32dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/metricTrainValue"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/text_1"
                    tools:text="2/3 次" />

                <TextView
                    style="@style/Text.Tertiary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/type_exercise"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/metricSleep"
            style="@style/Widget.Healix.MetricChip"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <com.healix.app.ui.widget.SparklineView
                android:id="@+id/metricSleepSpark"
                android:layout_width="32dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/metricSleepValue"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/text_1"
                    tools:text="7.2 h" />

                <TextView
                    style="@style/Text.Tertiary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/type_sleep"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/metricWeight"
            style="@style/Widget.Healix.MetricChip"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <com.healix.app.ui.widget.SparklineView
                android:id="@+id/metricWeightSpark"
                android:layout_width="32dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/metricWeightValue"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/text_1"
                    tools:text="65.4 kg" />

                <TextView
                    style="@style/Text.Tertiary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/type_body"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/metricSignal"
            style="@style/Widget.Healix.MetricChip"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <TextView
                android:id="@+id/metricSignalText"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/warning"
                tools:text="连续 3 天睡眠不足 · 今晚提前 1 小时熄灯" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/goalDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginTop="12dp"
        android:background="@color/line" />

    <!--
        主目标行 48dp（保留 v8 需求 5）：
        L1 = 主目标 + 目标体重；L2 = 现值与还差。
        「去调整 ›」→ GoalSetupSheet 编辑态；整行可点同此去向。
    -->
    <LinearLayout
        android:id="@+id/goalPrimaryRow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/goalPrimaryText"
                style="@style/Text.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="增重 · 目标 70 kg" />

            <TextView
                android:id="@+id/goalPrimarySub"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="现 65.4 kg，还差 4.6 kg" />
        </LinearLayout>

        <TextView
            android:id="@+id/goalAdjust"
            style="@style/Text.Link"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="0dp"
            android:text="@string/goal_adjust" />
    </LinearLayout>

    <!-- 计划提示条：整行可点（缺口 0 时改「今日已达标」；隐藏热量时整条不显示） -->
    <TextView
        android:id="@+id/planBar"
        style="@style/Text.Link"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        tools:text="还差 1280 kcal　查看今日建议 →" />

    <!-- 监督提示条：仅今日无记录时出现，无底色无线 -->
    <TextView
        android:id="@+id/nudgeBar"
        style="@style/Text.Link"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:text="@string/supervise_no_record"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
