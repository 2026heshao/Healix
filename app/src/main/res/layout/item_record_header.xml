<?xml version="1.0" encoding="utf-8"?>
<!--
    「记录」页滚动 header（v0.3 B2 / 需求 2：合并滚动区）。
    由 fragment_record.xml 原地抽出 —— 本文件承载**内容型**信息（随列表滚动离场）：
        goalArea（主目标行 + 三卡 + 盈余行）+ presetScroll + presetDivider
        + statusRow（多维状态行）+ nudgeBar（监督提示条）+ planBar（计划提示条）。
    操作反馈（offlineBar / undoBar）与输入条（inputBar）留在 fragment_record.xml
    固定区 —— 不得移入本文件（undoBar 的 5s 定时器挂在固定 View 上，绝不能随
    RecyclerView 回收，见 UndoBar 的 WeakHashMap 不变量）。
    id 与抽离前逐一相同：RecordFragment 经 ItemRecordHeaderBinding 以
    `headerBinding.xxx` 访问（`binding.xxx` 只剩固定区视图）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!--
        ══ 目标区（需求 5 → v8 问题 4 压缩：≈300–360dp → ≈142dp）══
        结构（自上而下）= 主目标行 48dp + 1dp 线 + 三卡横排 60dp + 1dp 线 + 今日盈余单行 32dp。
        原「目标宣言行 / 睡眠 80dp 折线 / 体重 80dp 折线 / 36sp 大数字 + 进度线 + 汇总行」
        全部下沉到半屏详情弹层（[com.healix.app.ui.GoalDetailSheet]）。
        硬约束：无卡片、无阴影 —— 三卡靠 1dp 竖线分区（规范 §1 原则 2）。
    -->
    <LinearLayout
        android:id="@+id/goalArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <!--
            ① 主目标行 48dp（满热区）
            L1 = 主目标 + 目标体重；L2 = 现值与还差（自由文本目标已归入个人信息页「我的目标」）。
            「去调整 ›」→ GoalSetupSheet 编辑态（**不跨页跳设置栏**）；整行可点同此去向。
        -->
        <LinearLayout
            android:id="@+id/goalPrimaryRow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/goalPrimaryText"
                    style="@style/Text.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="增重 · 目标 70 kg" />

                <TextView
                    android:id="@+id/goalPrimarySub"
                    style="@style/Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="现 65.4 kg，还差 4.6 kg" />
            </LinearLayout>

            <TextView
                android:id="@+id/goalAdjust"
                style="@style/Text.Link"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="0dp"
                android:text="@string/goal_adjust" />
        </LinearLayout>

        <View
            android:id="@+id/goalDividerA"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginEnd="@dimen/screen_margin"
            android:background="@color/line" />

        <!--
            ② 三卡横排 60dp：本周训练 / 近 7 日睡眠 / 近 30 日体重。
            **不是卡片**：格间只有 1dp 竖线，无底色、无边框（规范 §1 原则 2「不用容器」）。
            每格 = 标题(12sp/text_3) + 当前值(15sp/500) + 迷你趋势(20dp SparklineView)。
            点任一格 → 半屏详情弹层（[com.healix.app.ui.GoalDetailSheet]），默认定位该 metric。
            目标个数**不影响本块高度**：三格恒为训练 / 睡眠 / 体重（热量、饮水只在弹层里）。
        -->
        <LinearLayout
            android:id="@+id/goalCardRow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/goal_card_row_height"
            android:orientation="horizontal">

            <!-- ① 本周训练 -->
            <LinearLayout
                android:id="@+id/subTrainRow"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="10dp">

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/sub_goal_train"
                    android:textColor="@color/text_3" />

                <TextView
                    android:id="@+id/subTrainValue"
                    style="@style/Text.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    tools:text="2/3 次" />

                <com.healix.app.ui.widget.SparklineView
                    android:id="@+id/subTrainSpark"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/goal_mini_chart_height"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <View
                android:layout_width="@dimen/divider"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/line" />

            <!-- ② 近 7 日睡眠 -->
            <LinearLayout
                android:id="@+id/subSleepRow"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/sub_goal_sleep"
                    android:textColor="@color/text_3" />

                <TextView
                    android:id="@+id/subSleepValue"
                    style="@style/Text.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    tools:text="7.2 h" />

                <com.healix.app.ui.widget.SparklineView
                    android:id="@+id/subSleepSpark"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/goal_mini_chart_height"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <View
                android:layout_width="@dimen/divider"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="@color/line" />

            <!-- ③ 近 30 日体重（隐私隐藏时不绘制迷你图，但保留 20dp 空高，卡片不塌陷） -->
            <LinearLayout
                android:id="@+id/subWeightRow"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="@dimen/screen_margin">

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/sub_goal_weight"
                    android:textColor="@color/text_3" />

                <TextView
                    android:id="@+id/subWeightValue"
                    style="@style/Text.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    tools:text="65.4 kg" />

                <com.healix.app.ui.widget.SparklineView
                    android:id="@+id/subWeightSpark"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/goal_mini_chart_height"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/goalDividerB"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginEnd="@dimen/screen_margin"
            android:background="@color/line" />

        <!--
            ③ 今日盈余单行 32dp（原 36sp 大数字 + 进度线 + 汇总行 → 一条摘要）。
            正负由 6px 圆点着色（positive/negative **只用于圆点，不铺面**，规范 §2.1）。
            点整行 → 详情弹层（盈余视角）。
        -->
        <LinearLayout
            android:id="@+id/gapRow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/goal_insight_row_height"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin">

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/summary_label"
                android:textColor="@color/text_3" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <View
                android:id="@+id/gapDot"
                android:layout_width="@dimen/dot_size"
                android:layout_height="@dimen/dot_size"
                android:layout_marginEnd="6dp"
                android:background="@drawable/dot" />

            <TextView
                android:id="@+id/gapValue"
                style="@style/Text.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="+350" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:includeFontPadding="false"
                android:text="@string/kcal_unit"
                android:textColor="@color/text_2" />

            <ImageView
                android:id="@+id/gapChevron"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron"
                android:tint="@color/text_3"
                tools:ignore="ContentDescription" />
        </LinearLayout>
    </LinearLayout>

    <!-- 预设横条：横向滚动，13sp text_2，无边框（功能补充 2.1） -->
    <HorizontalScrollView
        android:id="@+id/presetScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/presetRow"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin" />
    </HorizontalScrollView>

    <View
        android:id="@+id/presetDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/line"
        android:visibility="gone"
        tools:visibility="visible" />

    <!--
        多维状态行（设计规范系统 §9.2）。
        恒定 48dp，**两态互斥**：摘要态 `运动 2/3 · 睡眠 7.2h · 体重 58.2kg`，
        有未读信号时原地切换为信号态（accent 文字），**不新增行、高度不变**。
        整行进入状态详情页；右侧 chevron 是"这一整块能进去"的暗示。
        （B2 注：原「与汇总区之间 28dp 留白」的汇总区已在 v8 问题 4 移除，
        marginTop 8dp 保留与目标区的间隔。）
    -->
    <LinearLayout
        android:id="@+id/statusRow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin">

        <TextView
            android:id="@+id/statusText"
            style="@style/Text.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="运动 2/3 · 睡眠 7.2h · 体重 58.2kg" />

        <ImageView
            android:id="@+id/statusChevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- 监督提示条：仅今日无记录时出现，无底色无线 -->
    <TextView
        android:id="@+id/nudgeBar"
        style="@style/Text.Link"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:text="@string/supervise_no_record"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- 计划提示条：整行可点 -->
    <TextView
        android:id="@+id/planBar"
        style="@style/Text.Link"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        tools:text="还差 1280 kcal　查看今日建议 →" />

</LinearLayout>
