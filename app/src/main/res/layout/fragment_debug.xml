<?xml version="1.0" encoding="utf-8"?>
<!-- 调试页（设计规范系统 4.5）：等宽数字，一行一条，1dp 分隔线。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingEnd="@dimen/screen_margin">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_toEndOf="@id/btnBack"
            android:gravity="center_vertical"
            android:text="@string/group_debug" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/line" />

    <!-- 今日汇总：调用次数、失败率、P95 -->
    <TextView
        android:id="@+id/summaryLine"
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="14dp"
        android:paddingBottom="4dp"
        tools:text="今日 7 次 · 失败 1 · P95 1.8s" />

    <!-- 今日 token 合计（§4.1）：输入 / 输出 -->
    <TextView
        android:id="@+id/tokenLine"
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="0dp"
        android:paddingBottom="14dp"
        tools:text="今日 token · 输入 1200 · 输出 800" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/line" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/callList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/emptyHint"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/debug_empty"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <!-- ══ 帧率探针 ★清单3 R4（独立诊断，默认关闭）══
         开关行（row_setting_switch，T03 引入后此处复用）+ 导出行（row_setting_value）。
         开关态落 filesDir 标志文件（诊断状态 ≠ 用户配置）；导出复用 DocumentWriter 管线。
         标签文字由 DebugFragment.setupPerfProbe 按行设置。 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/line" />

    <include
        android:id="@+id/probeSwitch"
        layout="@layout/row_setting_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/probeExport"
        layout="@layout/row_setting_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
