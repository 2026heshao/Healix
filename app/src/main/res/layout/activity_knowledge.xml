<?xml version="1.0" encoding="utf-8"?>
<!--
    知识库管理页（设计规范系统 10.3）：纯列表 + 分隔线，无 FAB、无图标。
    空态出现时隐藏「＋ 添加」纯文字项与文档容器，主按钮接管。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingEnd="@dimen/screen_margin">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_toEndOf="@id/btnBack"
            android:gravity="center_vertical"
            android:text="@string/knowledge_title" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/line" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- 文档行容器：代码 inflate row_knowledge_doc 动态填充（最新在最上） -->
            <LinearLayout
                android:id="@+id/docContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- ＋ 添加 PDF 文件：纯文字项 48dp（3.3），不用 FAB（9.7 ③ 先例） -->
            <TextView
                android:id="@+id/btnAdd"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_min"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:text="@string/knowledge_add"
                android:textColor="@color/text_2" />

            <!-- 空态（0 份文档）：居中文案 + 主按钮，出现时隐藏 btnAdd -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingTop="96dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/knowledge_empty_title" />

                <TextView
                    style="@style/Text.Tertiary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/knowledge_empty_hint" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnPick"
                    style="@style/Widget.Healix.Button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/knowledge_pick" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
