<?xml version="1.0" encoding="utf-8"?>
<!-- 计划 / 复盘（设计规范系统 4.3）：三宫格用文字对齐，不给数字套卡片。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingEnd="@dimen/screen_margin">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back" />

        <!-- 顶部文字 Tab，选中态 text_1 + 下方 2dp accent 线 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tabPlan"
                    style="@style/Text.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:minWidth="64dp"
                    android:text="@string/tab_plan" />

                <View
                    android:id="@+id/tabPlanUnderline"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/accent" />
            </LinearLayout>

            <!-- 训练 Tab（三 Tab：计划 | 训练 | 回顾，规范 §4.3 / §9.5） -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tabTraining"
                    style="@style/Text.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:minWidth="64dp"
                    android:text="@string/tab_training" />

                <View
                    android:id="@+id/tabTrainingUnderline"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/accent"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tabReview"
                    style="@style/Text.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:minWidth="64dp"
                    android:text="@string/tab_review" />

                <View
                    android:id="@+id/tabReviewUnderline"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/accent"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnRefresh"
            style="@style/Text.Link"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/refresh" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/line" />

    <!-- 缺口行：还差 X kcal -->
    <TextView
        android:id="@+id/gapLabel"
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:textColor="@color/accent"
        tools:text="还差 1280 kcal" />

    <View
        android:id="@+id/gapDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/line" />

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 计划 Tab 内容 -->
            <LinearLayout
                android:id="@+id/planGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/itemContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/planNote"
                    style="@style/Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin"
                    android:paddingTop="@dimen/block_gap"
                    android:paddingBottom="@dimen/block_gap"
                    tools:text="今日蛋白质偏低，晚餐优先补蛋白" />
            </LinearLayout>

            <!-- 复盘 Tab 内容：三宫格用文字对齐 -->
            <LinearLayout
                android:id="@+id/reviewGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:baselineAligned="true"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statIn"
                            style="@style/Text.Numeral"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="28sp"
                            tools:text="2180" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/review_stat_kcal_in" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statOut"
                            style="@style/Text.Numeral"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="28sp"
                            tools:text="1860" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/review_stat_kcal_out" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statWeight"
                            style="@style/Text.Numeral"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="28sp"
                            tools:text="58.2" />

                        <TextView
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/review_stat_weight" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/reviewText"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin"
                    android:paddingTop="24dp"
                    tools:text="今天热量盈余 320 kcal，达到增重目标。" />
            </LinearLayout>

            <!-- 训练 Tab 内容（规范 §9.5）：汇总行 / 训练日列表 / 空态 / 页脚 -->
            <LinearLayout
                android:id="@+id/trainingGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- 内联撤销条（规范 §9.6）：全宽 48dp，无底色无边框，同时最多 1 条 -->
                <LinearLayout
                    android:id="@+id/undoBar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/undoLeft"
                        style="@style/Text.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="已记录 运动 · 推（胸/肩/三头）" />

                    <TextView
                        android:id="@+id/undoAction"
                        style="@style/Text.Link"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_min"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center"
                        android:minWidth="@dimen/touch_min"
                        android:text="@string/undo" />
                </LinearLayout>

                <!-- 降级提示：source = fallback 时显示在页顶 -->
                <TextView
                    android:id="@+id/trainingModeLabel"
                    style="@style/Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin"
                    android:paddingTop="12dp"
                    android:text="@string/mode_simplified_local"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- 汇总行：本周 N 练 · 已完成 M -->
                <TextView
                    android:id="@+id/trainingSummary"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:visibility="gone"
                    tools:text="本周 3 练 · 已完成 2"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/trainingContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- 无计划时的空态 -->
                <LinearLayout
                    android:id="@+id/trainingEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/trainingEmptyTitle"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/screen_margin"
                        android:paddingEnd="@dimen/screen_margin"
                        android:paddingTop="20dp"
                        android:text="@string/training_empty" />

                    <TextView
                        android:id="@+id/trainingIntro"
                        style="@style/Text.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:paddingStart="@dimen/screen_margin"
                        android:paddingEnd="@dimen/screen_margin"
                        tools:text="结合你的目标（增重）和本周已练肌群，一次生成 7 天安排。" />

                    <Button
                        android:id="@+id/btnGenerate"
                        style="@style/Widget.Healix.Button"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginStart="@dimen/screen_margin"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="@dimen/screen_margin"
                        android:text="@string/training_generate" />

                    <TextView
                        android:id="@+id/trainingGeneratingHint"
                        style="@style/Text.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:paddingStart="@dimen/screen_margin"
                        android:paddingEnd="@dimen/screen_margin"
                        android:text="@string/training_generating_hint"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/trainingFailedRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/screen_margin"
                        android:paddingEnd="@dimen/screen_margin"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/trainingFailed"
                            style="@style/Text.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/training_failed"
                            android:textColor="@color/negative" />

                        <TextView
                            android:id="@+id/btnTrainingRetry"
                            style="@style/Text.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/touch_min"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:gravity="center"
                            android:minWidth="@dimen/touch_min"
                            android:text="@string/retry" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/trainingGoalFooter"
                        style="@style/Text.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/screen_margin"
                        android:paddingEnd="@dimen/screen_margin"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        tools:text="本周目标 3 次 · 休息日也会排出来" />
                </LinearLayout>

                <!-- 页脚：本周重点 -->
                <TextView
                    android:id="@+id/trainingNote"
                    style="@style/Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp"
                    android:visibility="gone"
                    tools:text="本周重点：卧推尝试比上周加 2.5kg"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 免责声明常驻底部 -->
    <TextView
        style="@style/Text.Tertiary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:text="@string/disclaimer"
        android:textSize="12sp" />

</LinearLayout>
