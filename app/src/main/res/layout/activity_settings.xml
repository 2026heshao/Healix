<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页（设计规范系统 4.4）：纯列表 + 分隔线，分组标题 12sp text_2，行高 56dp。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingEnd="@dimen/screen_margin">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_toEndOf="@id/btnBack"
            android:gravity="center_vertical"
            android:text="@string/settings" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/line" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- 模型服务 -->
            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:text="@string/group_model" />

            <include
                android:id="@+id/rowProvider"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowBaseUrl"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowModel"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowApiKey"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 测试连通性：本节唯一主按钮，宽度撑满 -->
            <Button
                android:id="@+id/btnTest"
                style="@style/Widget.Healix.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginEnd="@dimen/screen_margin"
                android:layout_marginTop="16dp"
                android:text="@string/test_conn" />

            <!-- 测试结果就地显示，不弹 Toast（结果需要能被反复查看） -->
            <TextView
                android:id="@+id/testResult"
                style="@style/Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginEnd="@dimen/screen_margin"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                tools:text="连通 · 1.2s"
                tools:visibility="visible" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider"
                android:layout_marginTop="@dimen/block_gap"
                android:background="@color/line" />

            <!-- 调用限制 -->
            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:text="@string/group_quota" />

            <include
                android:id="@+id/rowExtractQuota"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowChatQuota"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowRetry"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowRetryDelay"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider"
                android:layout_marginTop="@dimen/block_gap"
                android:background="@color/line" />

            <!-- 个人 -->
            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:text="@string/group_personal" />

            <include
                android:id="@+id/rowHeight"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowWeight"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowAge"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowActivity"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowTargetKcal"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowDayStart"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider"
                android:layout_marginTop="@dimen/block_gap"
                android:background="@color/line" />

            <!-- 数据 -->
            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:text="@string/group_data" />

            <include
                android:id="@+id/rowExport"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider"
                android:layout_marginTop="@dimen/block_gap"
                android:background="@color/line" />

            <!-- 调试 -->
            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:text="@string/group_debug" />

            <include
                android:id="@+id/rowDebugSummary"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
