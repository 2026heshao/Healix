<?xml version="1.0" encoding="utf-8"?>
<!--
    预设管理行：名称（text_1 15sp）+ 副行（kcal · 使用 N 次，text_3 13sp）+ 右箭头。
    点按 = 编辑；长按 = 删除（二次确认在 Activity 里做）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="14dp"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="早餐 鸡蛋×2+牛奶" />

        <TextView
            android:id="@+id/sub"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            tools:text="600 kcal · 用过 12 次" />
    </LinearLayout>

    <ImageView
        android:id="@+id/chevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron"
        android:tint="@color/text_3" />
</LinearLayout>
