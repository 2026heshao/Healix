<?xml version="1.0" encoding="utf-8"?>
<!--
    FieldSheet（§5.1 统一输入类弹窗）：复用 EventEditSheet 的底色容器规格
    （§3.5：bg_sheet + GrabberLayout + 把手 36×3dp + row_sheet_field 字段行）。
    结构 = 把手 + 标题 + 可编辑字段行容器 + 底部右对齐「取消 + 确认」。
    v6（11.5）：根容器 GrabberLayout —— 支持下拖关闭，并排除 input/button 误拖。
-->
<com.healix.app.ui.GrabberLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="20dp">

        <!-- 把手 -->
        <View
            android:layout_width="@dimen/handle_width"
            android:layout_height="@dimen/handle_height"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_handle" />

        <TextView
            android:id="@+id/sheetTitle"
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="编辑" />

        <!-- 字段行容器：由代码按字段规格动态填充（复用 row_sheet_field） -->
        <LinearLayout
            android:id="@+id/fieldContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- 底部按钮：右对齐（取消文字按钮 + 确认主按钮） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCancel"
                style="@style/Text.Link"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/cancel" />

            <Button
                android:id="@+id/btnConfirm"
                style="@style/Widget.Healix.Button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/confirm" />
        </LinearLayout>

    </LinearLayout>

</com.healix.app.ui.GrabberLayout>
