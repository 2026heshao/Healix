<?xml version="1.0" encoding="utf-8"?>
<!--
    v8 需求 4：「添加目标」弹窗（AddGoalSheet）版式。
    复用 FieldSheet / GoalSetupSheet 的容器规格（§3.5：bg_sheet + GrabberLayout + 把手），
    **不用系统 AlertDialog**（规避需求 3 的按钮坑，且贴合「无底色容器」规范）。
    结构 = 把手 + 标题 + 说明 + 可选目标列表（动态填充 row_setting_value 行）+ 取消。
-->
<com.healix.app.ui.GrabberLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        android:elevation="@dimen/card_elev_3"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="20dp">

        <!-- 把手 -->
        <View
            android:layout_width="@dimen/handle_width"
            android:layout_height="@dimen/handle_height"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_handle" />

        <TextView
            android:id="@+id/sheetTitle"
            style="@style/Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_goal_title" />

        <TextView
            android:id="@+id/sheetDesc"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/add_goal_desc" />

        <!-- 空态（无未启用目标时）：默认隐藏，由代码切换 -->
        <TextView
            android:id="@+id/emptyText"
            style="@style/Text.Tertiary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/add_goal_empty"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- 可选目标列表：每项 inflate row_setting_value 后加入 -->
        <LinearLayout
            android:id="@+id/optionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- 底部：取消（右对齐文字按钮） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCancel"
                style="@style/Text.Link"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/cancel" />
        </LinearLayout>

    </LinearLayout>

</com.healix.app.ui.GrabberLayout>
