<?xml version="1.0" encoding="utf-8"?>
<!--
    助理页（设计规范系统 4.2 + 11.1 v6；v8 需求 1/2 由 Activity 迁为常驻 Fragment）。
    消息区为左右气泡（v6：用户靠右 primary_container 衬底 + on_primary_container 字；
    助理靠左 surface 实底 + card_elev_1），气泡背景见 drawable/bg_bubble_user.xml
    与 bg_bubble_assistant.xml；工具反馈条见 ChatAdapter 内置的 bg_toolline。

    ⚠️ 与 v8 之前的旧对话页布局的差异：
      - **不再包含 tabbar** —— 全局 3 Tab 的 tabbar 现在唯一地挂在宿主
        MainActivity 布局里（TabBar.kt），Fragment 只承载内容；
      - 根容器不再需要 fitsSystemWindows —— 宿主已处理，重复设置会让
        adjustResize 的让位叠加两次。
    消息区与输入条为 tabbar 让位（padding/margin 80dp / 64dp，11.6）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶部：标题 + 会话日期。v6 后助理为 Tab 页，无二级返回语义，btnBack 已移除 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin">

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:gravity="center_vertical"
            android:text="@string/assistant" />

        <TextView
            android:id="@+id/sessionLabel"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            tools:text="今天" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/line" />

    <!-- 简化模式提示（降级）：text_2，不用 negative -->
    <TextView
        android:id="@+id/simplifiedBar"
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="@string/state_simplified"
        android:visibility="gone"
        tools:visibility="visible" />

    <!--
        内联撤销条（v0.3 B6；规范 §9.6）：AI 拟稿删除记录、用户确认后出现，5 秒后自动消失。
        与设置页 / 首页同构 —— 无底色无边框，靠文字区分。放在消息区上方，
        保证无论消息滚到哪里都可见。
    -->
    <LinearLayout
        android:id="@+id/undoBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/undoLeft"
            style="@style/Text.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="已删除 1 条记录，5 秒内可撤销" />

        <TextView
            android:id="@+id/undoAction"
            style="@style/Text.Link"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:minWidth="@dimen/touch_min"
            android:text="@string/undo" />
    </LinearLayout>

    <!-- 消息区：可滚动，输入区固定底部 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messageList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="20dp"
            android:paddingBottom="@dimen/list_bottom_pad"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/emptyHint"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/empty_hint"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <!-- 快捷入口三行（替代 chips）：仅空会话时出现 -->
    <LinearLayout
        android:id="@+id/quickGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/quickToday"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:text="@string/quick_today_ok" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"
            android:layout_marginStart="@dimen/screen_margin"
            android:background="@color/line" />

        <TextView
            android:id="@+id/quickDinner"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:text="@string/quick_dinner" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider"
            android:layout_marginStart="@dimen/screen_margin"
            android:background="@color/line" />

        <TextView
            android:id="@+id/quickWeek"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:text="@string/quick_week" />
    </LinearLayout>

    <!-- 预设快捷条（微扩展 C）：与记录页同一 presets 数据源，点击 = 直接落库。
         横向滚动，仅在查看今天且有预设时出现。 -->
    <HorizontalScrollView
        android:id="@+id/presetScroll"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:scrollbars="none"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/presetRow"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin" />
    </HorizontalScrollView>

    <!-- 免责声明：常驻消息区底部上方，不随滚动消失 -->
    <TextView
        style="@style/Text.Tertiary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="@string/disclaimer"
        android:textSize="12sp" />

    <!--
        输 入 区：**与记录页逐字同规格**（v6 输入条浮卡化 + 原型 `.inputbar` / `.field`）。
        几何口径（两页必须一致，改一处必同步另一处 fragment_record.xml 的同名块）：
          · 卡片外距 = marginStart screen_margin(20dp) / marginEnd 12dp
            （对应原型 `.inputbar{padding:10px 12px 10px 20px}`，左侧留白大于右侧）；
          · 卡片内距 = paddingStart 16dp / paddingEnd 6dp
            （对应原型 `.field{padding:0 6px 0 16px}`）；
          · 高度 = input_field_height(48dp)；16dp 圆角由 bg_input_bar 提供。
        ⚠️ 历史缺陷（2026-10-07 修）：本页此前是 match_parent 满宽 + padding 20/12
        ——把卡片外距当内距用，卡片铺满整屏；而记录页 v6 已按原型改成浮卡，
        两页并排时记录页输入条窄 32dp。此处补齐外距，两页卡片宽度对齐。
    -->
    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="@dimen/tab_raise"
        android:minHeight="@dimen/input_field_height"
        android:background="@drawable/bg_input_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="6dp">

        <EditText
            android:id="@+id/input"
            style="@style/Widget.Healix.QuickInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_chat_input"
            android:importantForAutofill="no"
            android:minHeight="@dimen/input_field_height" />

        <ProgressBar
            android:id="@+id/spinner"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/stateLabel"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:visibility="gone"
            tools:text="排队中 · 约 4s"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/send"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_send"
            android:tint="@color/btn_send_tint" />
    </LinearLayout>

</LinearLayout>

</FrameLayout>
