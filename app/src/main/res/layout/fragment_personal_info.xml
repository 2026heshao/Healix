<?xml version="1.0" encoding="utf-8"?>
<!--
    个人信息二级页（P1）：从「我的」页 · 数据组进入。
    结构 = 顶栏(back + 标题) + ScrollView；行形态与设置页一致（row_setting_value），
    v6 分组卡片包裹（bg_card），组标题 Widget.Healix.SectionTitle。
    字段弹窗走 FieldSheet（底色容器），列表选择类用 AlertDialog。
    背景多行区块沿用设置页原「补充说明」形态（EditText + 字数提示）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingEnd="@dimen/screen_margin">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_toEndOf="@id/btnBack"
            android:gravity="center_vertical"
            android:text="@string/personal_info_title" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/line" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="32dp">

            <!-- ══ 基本信息 ══ -->
            <TextView
                style="@style/Widget.Healix.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/personal_info_group_basic" />

            <LinearLayout
                style="@style/Widget.Healix.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="0dp">

                <!--
                    当前体重（F5 回归修正）：入口与存储分离 —— 点击弹数值输入，
                    确认后写一条 events(type=body)（与「记一笔」同一条数据管道）。
                -->
                <include
                    android:id="@+id/rowCurrentWeight"
                    layout="@layout/row_setting_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowHeight"
                    layout="@layout/row_setting_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowAge"
                    layout="@layout/row_setting_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowActivity"
                    layout="@layout/row_setting_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ══ 目标 ══
                 v8 问题 2a：「每日摄入」组整体移除（数值目标唯一归属设置页目标栏）；
                 本页只保留静态档案 + 只读「我的目标」（点击跳设置页目标栏）。 -->
            <TextView
                style="@style/Widget.Healix.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/group_goal" />

            <LinearLayout
                style="@style/Widget.Healix.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="0dp">

                <include
                    android:id="@+id/rowGoalStatement"
                    layout="@layout/row_setting_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- 清单3 R1/Q3：文本型自定义次目标只读展示行 —— 仅非空时可见（代码控制）。 -->
                <include
                    android:id="@+id/rowCustomGoal"
                    layout="@layout/row_setting_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ══ 我的情况（F6 结构化画像）：硬约束 + 软背景 ══ -->
            <TextView
                style="@style/Widget.Healix.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_background" />

            <LinearLayout
                style="@style/Widget.Healix.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="0dp">

                <include
                    android:id="@+id/rowProfileAllergens"
                    layout="@layout/row_setting_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowProfilePain"
                    layout="@layout/row_setting_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowProfileScene"
                    layout="@layout/row_setting_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowProfileSleep"
                    layout="@layout/row_setting_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 补充说明（F6 保留的自由文本）：多行输入框 + 字数提示，独立卡片区块 -->
            <LinearLayout
                style="@style/Widget.Healix.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_profile_extra" />

                <TextView
                    style="@style/Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/setting_background_hint" />

                <EditText
                    android:id="@+id/editBackground"
                    style="@style/Widget.Healix.BlockInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="top|start"
                    android:hint="@string/setting_background_ph"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="12"
                    android:minLines="5"
                    android:scrollbars="vertical" />

                <TextView
                    android:id="@+id/backgroundCount"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="end"
                    tools:text="0 / 2000" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
