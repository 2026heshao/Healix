<?xml version="1.0" encoding="utf-8"?>
<!--
    个人信息二级页（P1）：从「我的」页 · 数据组进入。
    结构 = 顶栏(back + 标题) + ScrollView；行形态与设置页一致（row_setting_value），
    分组标题 12sp text_2。字段弹窗走 FieldSheet（底色容器），列表选择类用 AlertDialog。
    背景多行区块沿用设置页原「补充说明」形态（EditText + 字数提示）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingEnd="@dimen/screen_margin">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_toEndOf="@id/btnBack"
            android:gravity="center_vertical"
            android:text="@string/personal_info_title" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/line" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- 基本信息 -->
            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:text="@string/personal_info_group_basic" />

            <!--
                当前体重（F5 回归修正）：入口与存储分离 —— 点击弹数值输入，
                确认后写一条 events(type=body)（与「记一笔」同一条数据管道），
                不在 settings 存静态体重字段；体重目标仍在设置页「目标」组。
            -->
            <include
                android:id="@+id/rowCurrentWeight"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowHeight"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowAge"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowActivity"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider"
                android:layout_marginTop="@dimen/block_gap"
                android:background="@color/line" />

            <!-- v8 问题 2a：「每日摄入」组整体移除（原 rowTargetKcal 行迁设置页「目标」栏）。
                 数值目标唯一归属设置页目标栏；本页只保留静态档案 + 自由文本「我的目标」。 -->
            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:text="@string/group_goal" />

            <include
                android:id="@+id/rowGoalStatement"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/divider"
                android:layout_marginTop="@dimen/block_gap"
                android:background="@color/line" />

            <!-- 我的情况（F6 结构化画像）：硬约束（忌口/疼痛）+ 软背景（场景/作息/补充说明） -->
            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:text="@string/setting_background" />

            <include
                android:id="@+id/rowProfileAllergens"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowProfilePain"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowProfileScene"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/rowProfileSleep"
                layout="@layout/row_setting_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 补充说明（F6 保留的自由文本）：多行输入框 + 字数提示，用独立区块 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingTop="12dp">

                <TextView
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_profile_extra" />

                <TextView
                    style="@style/Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/setting_background_hint" />

                <EditText
                    android:id="@+id/editBackground"
                    style="@style/Widget.Healix.BlockInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="top|start"
                    android:hint="@string/setting_background_ph"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="12"
                    android:minLines="5"
                    android:scrollbars="vertical" />

                <TextView
                    android:id="@+id/backgroundCount"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="end"
                    tools:text="0 / 2000" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
