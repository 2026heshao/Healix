<?xml version="1.0" encoding="utf-8"?>
<!--
    「记录」页（设计规范系统 4.1）。
    v8：由 `activity_main.xml` 的 pageHome 子树抽出，成为 `tabContainer` 上的
    常驻 Tab Fragment（[RecordFragment]）—— 与「助理」「我的」三页同为 Fragment，
    导航范式唯一（无半迁移）。

    v6 记录页改版：
    - 滚动 header 升级为 Filter chips（presetScroll）+ Hero 卡 + 指标 chip 行
      + 主目标行 + planBar + nudgeBar（见 item_record_header.xml）；
    - 输入条浮卡化（bg_input_bar 圆角卡 + input_field_height 高度）。

    v0.3 B2（需求 2：合并滚动区）—— 结构分两区：
    - 固定区（操作型，不随滚）：顶栏 + divider + offlineBar(状态提示条)
      + undoBar(撤销条) + inputBar(速记输入区)。
      ⚠️ undoBar 绝不能进 RecyclerView：UndoBar 用 WeakHashMap<View,Runnable>
      持 5s 定时器，宿主被回收即悬挂。
    - 滚动区（内容型，唯一滚动轴）：RecyclerView(list, weight=1)，adapter =
      ConcatAdapter(RecordHeaderAdapter, EventAdapter, RecordEmptyAdapter) ——
      header 见 item_record_header.xml，事件行见 item_event.xml，
      空态 footer 见 item_record_empty.xml。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recordRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 顶部：日期 + 设置。无 AppBar 阴影 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin">

        <TextView
            android:id="@+id/dateLabel"
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            tools:text="10月3日 周五" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider"
        android:background="@color/line" />

    <!--
        状态提示条（B2 起固定于工具栏之下，与设置页 undoBar 位置一致）：
        同一位置承载两种语义（文案与点击行为由 RecordFragment 按状态切换）
          - 无网络（state_offline）：点了重试
          - 未配置（no_provider_config）：点了去设置页
        用 text_2 中性色 —— 这两种都是预期行为，不是错误，不该用 negative。
    -->
    <TextView
        android:id="@+id/offlineBar"
        style="@style/Text.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="@string/state_offline"
        android:visibility="gone"
        tools:visibility="visible" />

    <!--
        内联撤销条（规范 §9.6）：写入成功后出现，5 秒后自动消失。
        与监督提示条同构 —— **无底色无边框**，靠文字区分，不做成"横幅"。
        同时最多 1 条，新条直接顶掉旧条（由 UndoBar 工具保证）。
        B2 起固定于工具栏之下（操作反馈，不随内容滚动）。
    -->
    <LinearLayout
        android:id="@+id/undoBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/undoLeft"
            style="@style/Text.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="已记录 饮食 · 约 600 kcal" />

        <TextView
            android:id="@+id/undoAction"
            style="@style/Text.Link"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:minWidth="@dimen/touch_min"
            android:text="@string/undo" />
    </LinearLayout>

    <!--
        列表：唯一滚动轴。无卡片，1dp 线分隔；ConcatAdapter 三段 =
        RecordHeaderAdapter(恒 1，内容 header) + EventAdapter(事件行) +
        RecordEmptyAdapter(空态 footer，仅无事件时 1 条)。
        clipToPadding=false + paddingBottom：末行不被 inputBar（含 tab_raise）盖住。
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/list_bottom_pad"
        android:scrollbars="none" />

    <!--
        速记输入区（v6 浮卡化）：surface 圆角浮卡（bg_input_bar，radius_md），高度
        input_field_height(48dp)，左右留 screen_margin / 12dp 边距，不再有顶线。
        marginBottom = tab_raise：抬升到全局 tabbar 之上，不被全局导航遮挡（11.6）。
        IME 弹出时由 TabBar.bindImeGuard 把这个 margin 归零，输入条贴住键盘顶。

        ★本块的几何（外距 20/12 + 内距 16/6 + 高 48dp）与助理页 fragment_assistant.xml
          的同名 inputBar **必须逐字一致** —— 两页输入条并排出现，任何一侧单改都会
          立刻表现为"两页输入框长度不一样"（2026-10-07 修过一次：助理页当时是满宽 +
          把外距当内距用，卡片宽 32dp）。改这里请同步另一处。
    -->
    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="@dimen/tab_raise"
        android:minHeight="@dimen/input_field_height"
        android:background="@drawable/bg_input_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="6dp">

        <EditText
            android:id="@+id/input"
            style="@style/Widget.Healix.QuickInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/hint_quick_input"
            android:importantForAutofill="no"
            android:minHeight="@dimen/input_field_height" />

        <!-- 状态：细环 + 13sp 灰字（限流必须显示预估秒数） -->
        <ProgressBar
            android:id="@+id/spinner"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/stateLabel"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:visibility="gone"
            tools:text="排队中 · 约 4s"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/send"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_send"
            android:tint="@color/btn_send_tint" />
    </LinearLayout>

</LinearLayout>
