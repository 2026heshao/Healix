<?xml version="1.0" encoding="utf-8"?>
<!--
    深色模式令牌 · v6。
    ⚠️ 本文件是**整份重定义**：键集合必须与 values/colors.xml 逐字相等，
    否则夜间模式会静默回落到白天值（不报错、用错色）。
-->
<resources>

    <!-- ═══ 主色系（primary）═══ -->
    <color name="primary">#D4703F</color>
    <color name="on_primary">#131211</color>
    <color name="primary_container">#4A2413</color>
    <color name="on_primary_container">#F7D9C9</color>
    <color name="primary_press">#C06134</color>

    <!-- ═══ 次色系（secondary）═══ -->
    <color name="secondary">#7FA3B8</color>
    <color name="on_secondary">#131211</color>
    <color name="secondary_container">#24343E</color>
    <color name="on_secondary_container">#A9C4D3</color>
    <color name="tertiary">#9B8BAB</color>

    <!-- ═══ 语义色 · 成功 ═══ -->
    <color name="success">#6E9E7C</color>
    <color name="on_success">#131211</color>
    <color name="success_container">#1F3526</color>
    <color name="on_success_container">#B9D6C2</color>

    <!-- ═══ 语义色 · 预警 ═══ -->
    <color name="warning">#D9A344</color>
    <color name="warning_container">#3A2E14</color>
    <color name="on_warning_container">#F0DCB4</color>

    <!-- ═══ 语义色 · 错误 ═══ -->
    <color name="error">#C4565A</color>
    <color name="on_error">#131211</color>
    <color name="error_container">#3B1F20</color>
    <color name="on_error_container">#EFC3C4</color>

    <!-- ═══ 中性色（暖调，不用冷灰）═══ -->
    <color name="bg">#121110</color>
    <color name="surface">#1C1B1A</color>
    <color name="surface_variant">#242220</color>
    <color name="surface_container">#2A2826</color>
    <color name="text_1">#F2F0ED</color>
    <color name="text_2">#A09C95</color>
    <color name="text_3">#6E6A64</color>
    <color name="outline">#3A3735</color>
    <color name="outline_variant">#2E2C2A</color>
    <color name="press">#252321</color>

    <!-- ═══ 事件类型标识：6px 低饱和圆点（v5 六色，值不改）═══ -->
    <color name="type_meal">#D4703F</color>
    <color name="type_exercise">#557F94</color>
    <color name="type_body">#8C7CA0</color>
    <color name="type_sleep">#66748F</color>
    <color name="type_illness">#C4565A</color>
    <color name="type_other">#B0ACA4</color>

    <!-- ═══ 其它 ═══ -->
    <color name="btn_disabled_bg">#3A3735</color>
    <color name="scrim">#7A000000</color>

    <!-- 进度条轨道色：深色 = 白色 14% 透明 -->
    <color name="progress_track">#24FFFFFF</color>

    <!-- 用户气泡文字 = on_primary_container（深色下气泡底为 primary_container #4A2413） -->
    <color name="bubble_user_text">@color/on_primary_container</color>

    <!-- ═══ 兼容别名（deprecated）═══ 键集合必须与 values/colors.xml 逐字相等。 -->
    <color name="accent">@color/primary</color>
    <color name="accent_press">@color/primary_press</color>
    <color name="positive">@color/success</color>
    <color name="negative">@color/error</color>
    <color name="line">@color/outline_variant</color>
    <color name="line_strong">@color/outline</color>

</resources>
