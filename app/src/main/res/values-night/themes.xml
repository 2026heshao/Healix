<?xml version="1.0" encoding="utf-8"?>
<!-- 深色主题：本文件**整份重定义** Theme.Healix（style 不跨资源限定符合并），
     令牌由 values-night/colors.xml 覆盖。不得新增组件样式。 -->
<resources>
    <style name="Theme.Healix" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:colorBackground">@color/bg</item>
        <!-- 窗口背景不透明（夜晚模式是整套重定义，styles 不跨资源限定符合并 → 必须在此再写一次）：
             转场首帧即不透明，消除二级页双窗口模型下的"露出上一个 Activity"叠影来源。 -->
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_1</item>
        <item name="android:textColorSecondary">@color/text_2</item>
        <item name="android:textColorHint">@color/text_2</item>

        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowActivityTransitions">false</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:textColorHighlight">@color/primary</item>

        <!-- 弹层容器透明（清单3 R2）：与 values/themes.xml 同条目。
             ⚠️ 本文件是**整份重定义**（style 不跨资源限定符合并），只改白天那份 =
             夜间模式弹层白底 bug 原样复现，故必须在此重复登记。 -->
        <item name="bottomSheetStyle">@style/Widget.Healix.BottomSheet</item>
    </style>
</resources>
