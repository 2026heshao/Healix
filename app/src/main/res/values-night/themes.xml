<?xml version="1.0" encoding="utf-8"?>
<!-- 深色主题：继承同一套 style，令牌由 values-night/colors.xml 覆盖。 -->
<resources>
    <style name="Theme.Healix" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_1</item>
        <item name="android:textColorSecondary">@color/text_2</item>
        <item name="android:textColorHint">@color/text_2</item>

        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowActivityTransitions">false</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorHighlight">@color/accent</item>
    </style>
</resources>
