<?xml version="1.0" encoding="utf-8"?>
<!--
    v6 助理气泡：surface 实底 + text_1 字。
    左上不对称圆角 4 / 16 / 16 / 16（TL / TR / BR / BL），尾角在左上。
    无描边（浅色下靠 surface 比页面 bg 略亮区分；深色下由布局补 1dp outline_variant 描边）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface" />
    <corners
        android:topLeftRadius="@dimen/bubble_tail_radius"
        android:topRightRadius="@dimen/bubble_radius"
        android:bottomRightRadius="@dimen/bubble_radius"
        android:bottomLeftRadius="@dimen/bubble_radius" />
</shape>
