<?xml version="1.0" encoding="utf-8"?>
<!-- v6 Filter chip 底：selector（selected primary_container / 常态 surface_variant），radius_sm(8dp)。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_container" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_variant" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
</selector>
