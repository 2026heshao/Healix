<?xml version="1.0" encoding="utf-8"?>
<!--
    v6 用户气泡：primary_container 实底（文字 = on_primary_container）。
    右上不对称圆角 16 / 4 / 16 / 16（TL / TR / BR / BL），尾角在右上。
    无阴影、无渐变、无描边。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/primary_container" />
    <corners
        android:topLeftRadius="@dimen/bubble_radius"
        android:topRightRadius="@dimen/bubble_tail_radius"
        android:bottomRightRadius="@dimen/bubble_radius"
        android:bottomLeftRadius="@dimen/bubble_radius" />
</shape>
