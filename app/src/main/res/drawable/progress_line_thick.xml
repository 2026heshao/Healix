<?xml version="1.0" encoding="utf-8"?>
<!-- v6 粗进度线（8dp）：layer-list = bg_progress_track + bg_progress_fill。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:drawable="@drawable/bg_progress_track" />
    <item android:id="@android:id/progress">
        <clip android:drawable="@drawable/bg_progress_fill" />
    </item>
</layer-list>
