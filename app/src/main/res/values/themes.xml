<?xml version="1.0" encoding="utf-8"?>
<!--
    主题与组件样式 · v6。
    ⚠️ 只引用颜色令牌的组件样式**只登记在 values/themes.xml**；
       这些样式名已加入 pipeline/check_night_parity.py 的 WHITELIST_DAY_ONLY。
       values-night/themes.xml 只整份重定义 Theme.Healix，不新增组件样式。
    阴影在 Android 用 android:elevation 表达；drawable 只负责底色 + 圆角。
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Healix" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- 底色与文本 -->
        <item name="android:colorBackground">@color/bg</item>
        <!-- 窗口背景不透明：转场首帧（内容尚未绘制时）也露出底色而非上一个 Activity，
             消除二级页双窗口模型下的第二条"叠影"来源（见 11.2）。 -->
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_1</item>
        <item name="android:textColorSecondary">@color/text_2</item>
        <item name="android:textColorHint">@color/text_2</item>

        <!-- 状态栏：与底色同色，不要彩色 -->
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- 关闭一切 Material 默认装饰（避免阴影 / 抬起 / 涟漪色块） -->
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowActivityTransitions">false</item>
        <item name="colorAccent">@color/primary</item>

        <!-- 输入光标用 primary，不做彩色描边 -->
        <item name="android:textColorHighlight">@color/primary</item>

        <!-- 弹层容器透明（清单3 R2）：BottomSheetDialog 外层容器 design_bottom_sheet
             默认不透明白底（colorSurface），而项目弹层用 GrabberLayout 自拖拽
             （拖拽位移设在卡片自身，GrabberLayout.kt:72）→ 卡片被拖走后露出容器白底。
             指向透明样式后容器白底消失；各弹层自己的 bg_sheet 圆角卡片（GrabberLayout
             内层）不透明、随拖移动，遮罩 dim / 点遮罩关闭均不受影响。 -->
        <item name="bottomSheetStyle">@style/Widget.Healix.BottomSheet</item>
    </style>

    <!-- 启动主题：纯底色，不做 splash 动画 -->
    <style name="Theme.Healix.Splash" parent="Theme.Healix">
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <!--
        主按钮（v6）：高 52dp，radius_md(16dp)，左右 padding 24dp，
        底 primary，文字 btn_primary_text 15sp/600，无阴影。
    -->
    <style name="Widget.Healix.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_height">@dimen/btn_primary_height</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Tonal 按钮（新增）：次级主动作（"测试连通性"）。高 48dp，secondary_container 底，
         secondary 文字 15sp/600，radius_md。 -->
    <style name="Widget.Healix.ButtonTonal" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:background">@drawable/bg_btn_tonal</item>
        <item name="android:textColor">@color/secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- 文字按钮（v6）：无底色无边框，primary 15sp/600，触控热区 48dp -->
    <style name="Widget.Healix.TextButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Healix.TextButton.Danger">
        <item name="android:textColor">@color/error</item>
    </style>

    <!-- 卡片（新增）：surface 实底 + 16dp 圆角，阴影靠 elevation（elev_1）。
         左右 margin = screen_margin。 -->
    <style name="Widget.Healix.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:elevation">@dimen/card_elev_1</item>
        <item name="android:padding">@dimen/card_padding</item>
        <item name="android:layout_marginStart">@dimen/screen_margin</item>
        <item name="android:layout_marginEnd">@dimen/screen_margin</item>
    </style>

    <!-- Filter chip（新增）：高 chip_height，底色 bg_chip selector，文字 chip_text selector。 -->
    <style name="Widget.Healix.Chip" parent="">
        <item name="android:layout_height">@dimen/chip_height</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">@dimen/chip_pad_h</item>
        <item name="android:paddingEnd">@dimen/chip_pad_h</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- 指标 chip（新增）：高 48dp，surface 实底 8dp 圆角，elev_1。 -->
    <style name="Widget.Healix.MetricChip" parent="">
        <item name="android:layout_height">@dimen/metric_chip_height</item>
        <item name="android:background">@drawable/bg_metric_chip</item>
        <item name="android:elevation">@dimen/card_elev_1</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- 分区标题（新增）：parent Text.Caption，text_2，左右 screen_margin 内缩。 -->
    <style name="Widget.Healix.SectionTitle" parent="Text.Caption">
        <item name="android:textColor">@color/text_2</item>
        <item name="android:paddingStart">@dimen/screen_margin</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- 速记框输入（3.2）：无背景无边框 15sp -->
    <style name="Widget.Healix.QuickInput" parent="">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@null</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_1</item>
        <item name="android:textColorHint">@color/text_2</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:inputType">textMultiLine|textCapSentences</item>
        <item name="android:maxLines">3</item>
    </style>

    <!-- 设置页多行输入（背景项）。
         **不设固定行高**、不右对齐 —— 背景是一段自由文本，右对齐会很难读；
         给一条 1dp 顶线做视觉锚点即可，仍遵守「无卡片 / 无阴影 / 圆角仅 8dp /
         无 emoji」的设计规范 v3。 -->
    <style name="Widget.Healix.BlockInput" parent="">
        <item name="android:background">@drawable/bg_input_top_line</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_1</item>
        <item name="android:textColorHint">@color/text_3</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:inputType">textMultiLine|textCapSentences</item>
    </style>

    <!-- 列表项（3.3）：无卡片，1dp 线分隔 -->
    <style name="Widget.Healix.ListRow" parent="">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:minHeight">@dimen/item_height</item>
        <item name="android:paddingStart">@dimen/screen_margin</item>
        <item name="android:paddingEnd">@dimen/screen_margin</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.Healix.SettingRow" parent="Widget.Healix.ListRow">
        <item name="android:minHeight">@dimen/setting_row_height</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <!-- BottomSheet 弹层容器（清单3 R2）：透明。
         style 本身无颜色令牌 → 只在 values 定义一次，白天/夜间两份 Theme.Healix 共用
         （values-night 是整份重定义，但 style 定义不随限定符重复——重复定义反而冲突）。
         一处覆盖全部 7 个 BottomSheetDialogFragment 弹层。 -->
    <style name="Widget.Healix.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
    </style>

</resources>
