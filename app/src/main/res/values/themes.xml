<?xml version="1.0" encoding="utf-8"?>
<!--
    主题。硬约束（设计规范系统 v3）：
    - 无卡片、无阴影、无渐变
    - 全局唯一强调色 accent
    - 字重只有 400 / 500
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Healix" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- 底色与文本 -->
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_1</item>
        <item name="android:textColorSecondary">@color/text_2</item>
        <item name="android:textColorHint">@color/text_2</item>

        <!-- 状态栏：与底色同色，不要彩色 -->
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- 关闭一切 Material 默认装饰（避免阴影 / 抬起 / 涟漪色块） -->
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowActivityTransitions">false</item>
        <item name="colorAccent">@color/accent</item>

        <!-- 输入光标用 accent，不做彩色描边 -->
        <item name="android:textColorHighlight">@color/accent</item>
    </style>

    <!-- 启动主题：纯底色，不做 splash 动画 -->
    <style name="Theme.Healix.Splash" parent="Theme.Healix">
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <!--
        主按钮（组件规范 3.1）
        高 48dp，圆角 8dp，左右 padding 24dp，底 accent，文字白 13sp/500
        无阴影、无渐变
    -->
    <style name="Widget.Healix.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- 文字按钮（3.1）：无底色无边框，accent 13sp/500，触控热区 48dp -->
    <style name="Widget.Healix.TextButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Healix.TextButton.Danger">
        <item name="android:textColor">@color/negative</item>
    </style>

    <!-- 设置输入行（3.2）：高 56dp，无下划线 -->
    <style name="Widget.Healix.SettingInput" parent="">
        <item name="android:layout_height">@dimen/setting_row_height</item>
        <item name="android:background">@null</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_1</item>
        <item name="android:textColorHint">@color/text_2</item>
        <item name="android:gravity">end</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>

    <!-- 速记框输入（3.2）：无背景无边框 15sp -->
    <style name="Widget.Healix.QuickInput" parent="">
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@null</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_1</item>
        <item name="android:textColorHint">@color/text_2</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:inputType">textMultiLine|textCapSentences</item>
        <item name="android:maxLines">3</item>
    </style>

    <!-- 列表项（3.3）：无卡片，1dp 线分隔 -->
    <style name="Widget.Healix.ListRow" parent="">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:minHeight">@dimen/item_height</item>
        <item name="android:paddingStart">@dimen/screen_margin</item>
        <item name="android:paddingEnd">@dimen/screen_margin</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.Healix.SettingRow" parent="Widget.Healix.ListRow">
        <item name="android:minHeight">@dimen/setting_row_height</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

</resources>
