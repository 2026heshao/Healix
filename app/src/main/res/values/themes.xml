<?xml version="1.0" encoding="utf-8"?>
<!--
    主题。硬约束（设计规范系统 v3）：
    - 无卡片、无阴影、无渐变
    - 全局唯一强调色 accent
    - 字重只有 400 / 500
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Healix" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- 底色与文本 -->
        <item name="android:colorBackground">@color/bg</item>
        <!-- 窗口背景不透明：转场首帧（内容尚未绘制时）也露出底色而非上一个 Activity，
             消除二级页双窗口模型下的第二条"叠影"来源（见 11.2）。 -->
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_1</item>
        <item name="android:textColorSecondary">@color/text_2</item>
        <item name="android:textColorHint">@color/text_2</item>

        <!-- 状态栏：与底色同色，不要彩色 -->
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- 关闭一切 Material 默认装饰（避免阴影 / 抬起 / 涟漪色块） -->
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowActivityTransitions">false</item>
        <item name="colorAccent">@color/accent</item>

        <!-- 输入光标用 accent，不做彩色描边 -->
        <item name="android:textColorHighlight">@color/accent</item>

        <!-- 弹层容器透明（清单3 R2）：BottomSheetDialog 外层容器 design_bottom_sheet
             默认不透明白底（colorSurface），而项目弹层用 GrabberLayout 自拖拽
             （拖拽位移设在卡片自身，GrabberLayout.kt:72）→ 卡片被拖走后露出容器白底。
             指向透明样式后容器白底消失；各弹层自己的 bg_sheet 圆角卡片（GrabberLayout
             内层）不透明、随拖移动，遮罩 dim / 点遮罩关闭均不受影响。 -->
        <item name="bottomSheetStyle">@style/Widget.Healix.BottomSheet</item>
    </style>

    <!-- 启动主题：纯底色，不做 splash 动画 -->
    <style name="Theme.Healix.Splash" parent="Theme.Healix">
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <!--
        主按钮（组件规范 3.1）
        高 48dp，圆角 8dp，左右 padding 24dp，底 accent，文字白 13sp/500
        无阴影、无渐变
    -->
    <style name="Widget.Healix.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- 文字按钮（3.1）：无底色无边框，accent 13sp/500，触控热区 48dp -->
    <style name="Widget.Healix.TextButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Healix.TextButton.Danger">
        <item name="android:textColor">@color/negative</item>
    </style>

    <!-- 设置输入行（3.2）：高 56dp，无下划线 -->
    <style name="Widget.Healix.SettingInput" parent="">
        <item name="android:layout_height">@dimen/setting_row_height</item>
        <item name="android:background">@null</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_1</item>
        <item name="android:textColorHint">@color/text_2</item>
        <item name="android:gravity">end</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">0dp</item>
    </style>

    <!-- 速记框输入（3.2）：无背景无边框 15sp -->
    <style name="Widget.Healix.QuickInput" parent="">
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@null</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_1</item>
        <item name="android:textColorHint">@color/text_2</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:inputType">textMultiLine|textCapSentences</item>
        <item name="android:maxLines">3</item>
    </style>

    <!-- 设置页多行输入（背景项）。
         与 SettingInput 的区别：**不设固定行高**、不右对齐 ——
         背景是一段自由文本，右对齐会很难读；给一条 1dp 顶线做视觉锚点即可，
         仍遵守「无卡片 / 无阴影 / 圆角仅 8dp / 无 emoji」的设计规范 v3。 -->
    <style name="Widget.Healix.BlockInput" parent="">
        <item name="android:background">@null</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_1</item>
        <item name="android:textColorHint">@color/text_3</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:inputType">textMultiLine|textCapSentences</item>
    </style>

    <!-- 列表项（3.3）：无卡片，1dp 线分隔 -->
    <style name="Widget.Healix.ListRow" parent="">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:minHeight">@dimen/item_height</item>
        <item name="android:paddingStart">@dimen/screen_margin</item>
        <item name="android:paddingEnd">@dimen/screen_margin</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.Healix.SettingRow" parent="Widget.Healix.ListRow">
        <item name="android:minHeight">@dimen/setting_row_height</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <!-- BottomSheet 弹层容器（清单3 R2）：透明。
         style 本身无颜色令牌 → 只在 values 定义一次，白天/夜间两份 Theme.Healix 共用
         （values-night 是整份重定义，但 style 定义不随限定符重复——重复定义反而冲突）。
         一处覆盖全部 7 个 BottomSheetDialogFragment 弹层。 -->
    <style name="Widget.Healix.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
    </style>

</resources>
