<?xml version="1.0" encoding="utf-8"?>
<!--
    Healix 设计令牌（浅色）。
    规范来源：Healix设计规范系统.md 第二章。
    硬约束：全局只有 1 个强调色（accent）；positive / negative 只用于文字与 6px 圆点。
-->
<resources>

    <!-- 中性色（暖调，不用冷灰） -->
    <color name="bg">#FAFAF9</color>
    <color name="surface">#FFFFFF</color>
    <color name="text_1">#1A1918</color>
    <color name="text_2">#6E6B66</color>
    <color name="text_3">#9C9891</color>
    <color name="line">#EAE8E4</color>
    <color name="line_strong">#DAD7D2</color>
    <color name="press">#F2F1EE</color>

    <!-- 强调与语义色 -->
    <color name="accent">#B85028</color>
    <color name="accent_press">#A3451F</color>
    <color name="positive">#4A7C59</color>
    <color name="negative">#A63D40</color>

    <!-- 事件类型标识：6px 低饱和圆点，不做彩色徽章 -->
    <color name="type_meal">#B85028</color>
    <color name="type_exercise">#3D5A6C</color>
    <color name="type_body">#6B5B7B</color>
    <color name="type_sleep">#4A5568</color>
    <color name="type_illness">#A63D40</color>
    <color name="type_other">#9C9891</color>

    <!-- 主按钮禁用态 -->
    <color name="btn_disabled_bg">#DAD7D2</color>
    <color name="scrim">#52000000</color>

</resources>
