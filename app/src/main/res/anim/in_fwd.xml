<?xml version="1.0" encoding="utf-8"?>
<!--
    前进转场（设计规范 11.2）：新页 translateX(22%)→0。
    ⚠️ 仅位移、恒不透明 —— 不加 alpha。Android 是双窗口共存模型，
       入场窗口一旦半透明，被盖住的旧窗口会透出，形成"页面叠影"。
       时长 180ms（v8 需求1：由 400ms 收紧，缩短感知冻结窗口）。由 NavHost.setCustomAnimations 注入（前进方向）。
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:duration="180"
    android:shareInterpolator="true">

    <translate
        android:fromXDelta="22%"
        android:toXDelta="0" />
</set>
