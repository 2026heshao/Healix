<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络：调用云端大模型 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 通知栏录入（Android 13+ 必须运行时申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 常驻通知依赖前台服务。Android 14 (API 34) 起必须声明 FOREGROUND_SERVICE_SPECIAL_USE -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 电池优化白名单引导（国行 ROM 会杀后台，见总方案第十节） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 开机自启：重启后恢复常驻通知（部分 ROM 仍需用户手动加白） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".HealixApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Healix"
        tools:targetApi="35">

        <!-- 主界面 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Healix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- v8：助理页迁为 MainActivity 常驻 AssistantFragment，ChatActivity 已删除 -->

        <activity
            android:name=".ui.PlanReviewActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <!-- 个人信息页（P1）：设置页「个人 / 我的情况」两组迁至此，入口在「我的」页数据组 -->
        <activity
            android:name=".ui.PersonalInfoActivity"
            android:exported="false" />

        <!--
            v8 T03：知识库 / 资源清单 / 预设管理 / 调试 已迁为宿主内的二级页 Fragment
            （NavHost + activity_main 的 pageContainer），四者的 <activity> 声明同帧删除。
        -->

        <!--
            状态详情页（设计规范系统 9.4）：从首页状态行进入的二级页。
            承载 运动 / 睡眠 / 体重 / 身体 四段，含趋势折线、信号列表、提醒清单。
        -->
        <activity
            android:name=".ui.StatusDetailActivity"
            android:exported="false" />

        <!--
            常驻通知录入服务。
            Android 14 必须匹配 foregroundServiceType，否则 startForeground() 抛异常。
            ⚠️ specialUse 在部分国产 ROM 上可能被忽略 —— 真机需验证（见 docs/待核实清单）。
        -->
        <service
            android:name=".notify.QuickInputService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="health_quick_input" />
        </service>

        <!-- 通知栏 RemoteInput 的接收者 -->
        <receiver
            android:name=".notify.QuickInputReceiver"
            android:exported="false" />

        <!-- 撤销上一笔：发出后 5 秒内可点（UI 设计方案 5.2） -->
        <receiver
            android:name=".notify.UndoReceiver"
            android:exported="false" />

        <!-- 开机广播：恢复常驻通知 -->
        <receiver
            android:name=".notify.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            桌面小工具（微扩展 E·方案 B）：本周运动缺口 + 记一笔。
            updatePeriodMillis=0 —— 刷新全部由 App 写入点主动推（app-pushes-updates）。
        -->
        <receiver
            android:name=".widget.HealixWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/healix_widget_info" />
        </receiver>

    </application>

</manifest>
