# Healix —— 敏感与构建产物忽略清单
# 硬约束：绝不提交任何 key

# 密钥与本机配置
local.properties
*.keystore
*.jks
keystore.properties
secrets.properties

# 环境变量文件
.env
.env.*
!.env.example

# 构建产物
*.iml
.gradle/
build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
output.json

# IDE
.idea/
*.hprof
.DS_Store
Thumbs.db

# Python 竖切片产物
pipeline/*.db
pipeline/*.db-wal
pipeline/*.db-shm
pipeline/regression_report.json
pipeline/__pycache__/
**/__pycache__/
*.py[cod]
.venv/
venv/

# 回归测试运行日志：含 API 原始响应，不入库
.regression*.log
*.regression.log

# CI 运行日志（排障时从 Actions 下载，属临时诊断产物）
.ci*.log

# 工作区本地数据（记忆/会话缓存），属本机状态而非项目源码
.workbuddy/

# 明确保留：Room schema 历史（迁移必须可追溯）
!app/schemas/

# CI 日志临时文件（排查用，不入库）
.ci_log_*.txt

# 开发文档不入库（用户 2026-10-03 指定：开发文档只在本机 docs/ 归档，不进 git）
